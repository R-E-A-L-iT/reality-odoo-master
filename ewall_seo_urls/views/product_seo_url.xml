<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Product Template Form View Inherit -->
    <record id="product_template_extension_form_view" model="ir.ui.view">
        <field name="name">product.template.extension.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group string="SEO">
                    <field name="seo_url_language"/>
                    <field name="seo_url" />
                </group>
            </xpath>
        </field>
    </record>
    <!-- category Form View Inherit -->
    <record id="website_product_category_website" model="ir.ui.view">
        <field name="name">product.category.description.view</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"></field>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('col-lg-6')]" position="after">
                <group string="SEO">
                    <field name="seo_url_language"/>
                    <field name="seo_url"></field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
