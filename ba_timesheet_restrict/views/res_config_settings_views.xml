<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_config_settings_timesheet" model="ir.ui.view">
        <field name="name">res.config.settings.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Timesheets">
                    <h2>Timesheet Restrictions</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="timesheet_allowed_past_days"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Past Days for Timesheets</span>
                                <span class="text-muted">
                                    Define how many past days users can log timesheets for. Set to 0 to disallow past entries.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
