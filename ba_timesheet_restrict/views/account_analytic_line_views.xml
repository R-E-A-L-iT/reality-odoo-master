<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_analytic_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form.inherit.timesheet.restriction</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.view_account_analytic_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="options">{'datepicker': {'maxDate': '0'}}}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
