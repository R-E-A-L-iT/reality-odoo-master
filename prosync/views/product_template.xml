<odoo>
   <record id="prosync_product_view" model="ir.ui.view">
       <field name="name">product.template.common.form.view</field>
       <field name="model">product.template</field>
       <field name="priority">3</field>
       <field name="inherit_id" ref="product.product_template_only_form_view" />
       <field name="arch" type="xml">
           <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="discontinued"/>
                    <label for="discontinued"/>
                </span>
            </xpath>
       </field>
   </record>

   <!--
       Extend the default product.template search view so that typing a value
       in the search bar also matches the SKU field.
   -->
   <record id="product_template_search_view_sku" model="ir.ui.view">
       <field name="name">product.template.search.sku</field>
       <field name="model">product.template</field>
       <field name="inherit_id" ref="product.product_template_search_view"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='name']" position="replace">
               <field name="name" string="Product"
                   filter_domain="['|', '|', '|', '|',
                       ('default_code', 'ilike', self),
                       ('product_variant_ids.default_code', 'ilike', self),
                       ('name', 'ilike', self),
                       ('barcode', 'ilike', self),
                       ('sku', 'ilike', self)]"/>
           </xpath>
       </field>
   </record>

   <!--
       product.product_search_form_view inherits the template search view and
       replaces the name field with its own filter_domain for product.product
       (the variant model used by Inventory, Purchases, etc.).  Override it
       here so SKU is included at that level too.  Because product.product
       uses _inherits from product.template, 'sku' is a delegated field and
       is directly searchable on product.product without a dot-path.
   -->
   <record id="product_product_search_form_view_sku" model="ir.ui.view">
       <field name="name">product.product.search.sku</field>
       <field name="model">product.product</field>
       <field name="inherit_id" ref="product.product_search_form_view"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='name']" position="replace">
               <field name="name" string="Product"
                   filter_domain="['|', '|', '|',
                       ('default_code', 'ilike', self),
                       ('name', 'ilike', self),
                       ('barcode', 'ilike', self),
                       ('sku', 'ilike', self)]"/>
           </xpath>
       </field>
   </record>
</odoo>