<odoo>
    <record id="prosync_report_action" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sync reports found.</p>
        </field>
    </record>

    <record id="view_prosync_report_tree" model="ir.ui.view">
        <field name="name">prosync.report.tree</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sync_type"/>
                <field name="start_time"/>
                <field name="end_time"/>
            </tree>
        </field>
    </record>

    <record id="view_prosync_report_form" model="ir.ui.view">
        <field name="name">prosync.report.form</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <form string="Sync Report">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sync_type"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <menuitem id="menu_prosync_root" name="ProSync" sequence="10" groups="base.group_system"/>

    <menuitem id="menu_prosync_reports"
              name="Sync Reports"
              parent="menu_prosync_root"
              action="prosync_report_action"
              sequence="1"
              groups="base.group_system"/>
</odoo>
