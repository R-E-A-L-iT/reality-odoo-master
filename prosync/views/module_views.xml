<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- action -->
    <record id="action_sync_report_tree" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- app dashboard menu -->
    <menuitem
        id="menu_sync_reports"
        name="Sync Reports"
        sequence="10"
        action="action_sync_report_tree"
        parent=""
        groups="base.group_no_one" /> <!-- Visible in developer mode only -->

    <!-- report list view -->
    <record id="action_sync_report_tree" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sync_report_tree" model="ir.ui.view">
        <field name="name">prosync.report.tree</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Report Name"/>
            </tree>
        </field>
    </record>

    <record id="action_start_sync_schedule" model="ir.actions.server">
        <field name="name">Start a Sync</field>
        <field name="model_id" ref="prosync.model_prosync_report"/>
        <field name="state">code</field>
        <field name="code">
            action = env.ref('prosync.ir_cron_prosync_schedule')
            if action:
                action._trigger()
        </field>
    </record>

    <record id="action_prosync_report" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="prosync.view_sync_report_tree"/>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="prosync.model_prosync_report"/>
        <field name="toolbar" eval="{
            'action': [ (ref('prosync.action_start_sync_schedule'), 'Start a Sync') ]
        }"/>
    </record>

    <record id="action_start_sync_schedule_binding" model="ir.values">
        <field name="key">action</field>
        <field name="model">prosync.report</field>
        <field name="name">Start a Sync</field>
        <field name="value" eval="'ir.actions.server,%d' % ref('prosync.action_start_sync_schedule')"/>
    </record>



    <!-- report record view -->
    <record id="view_sync_report_form" model="ir.ui.view">
        <field name="name">prosync.report.form</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <form string="Sync Report">
                <sheet>
                    <!-- <group>
                        <field name="name" />
                        <field name="status" />
                        <field name="start_datetime" />
                        <field name="end_datetime" />
                        <field name="sync_duration" />
                    </group>
                    <notebook>
                        <page string="Error Report">
                            <field name="error_report" 
                                widget="text_area" 
                                style="width: 100%; height: 200px;" 
                                placeholder="No errors yet..." />
                        </page>
                        <page string="Items Updated">
                            <field name="items_updated" 
                                widget="text_area" 
                                style="width: 100%; height: 200px;" 
                                placeholder="No items updated..." />
                        </page>
                    </notebook> -->
                </sheet>
            </form>
        </field>
    </record>
</odoo>
