<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_sync_report_tree" model="ir.ui.view">
        <field name="name">prosync.report.tree</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Report Name"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sync_report_form" model="ir.ui.view">
        <field name="name">prosync.report.form</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <form string="Sync Report">
                <header>
                    <button name="manual_trigger_prosync_schedule"
                            type="object"
                            string="Start a Sync"
                            class="btn-primary"
                            context="{}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Server Action that triggers the scheduled action -->
    <record id="action_start_sync_schedule" model="ir.actions.server">
        <field name="name">Start a Sync</field>
        <field name="model_id" ref="model_prosync_report"/>
        <field name="binding_model_id" ref="model_prosync_report"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            if env.ref('prosync.ir_cron_prosync_schedule', raise_if_not_found=False):
                env.ref('prosync.ir_cron_prosync_schedule').method_direct_trigger()
        </field>
    </record>

    <!-- Tree + Form Action -->
    <record id="action_prosync_report" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_sync_report_tree"/>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="model_prosync_report"/>
    </record>

    <!-- Menu (Visible to devs only for now) -->
    <menuitem
        id="menu_sync_reports"
        name="Sync Reports"
        sequence="10"
        action="action_prosync_report"
        parent=""
        groups="base.group_no_one" />

</odoo>
