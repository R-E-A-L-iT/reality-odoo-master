<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- action -->
        <record id="action_sync_report_tree" model="ir.actions.act_window">
            <field name="name">Sync Reports</field>
            <field name="res_model">prosync.report</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_type': 1}</field>
        </record>

        <!-- app dashboard menu -->
        <menuitem
            id="menu_sync_reports"
            name="Sync Reports"
            sequence="10"
            web_icon="prosync,static/description/icon.png"
            action="action_sync_report_tree"
            groups="base.group_no_one" /> <!-- Visible in developer mode only -->

        <!-- report search view -->
        <record id="view_sync_report_search" model="ir.ui.view">
            <field name="name">prosync.report.search</field>
            <field name="model">prosync.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Name"/>
                    <filter name="filter_rental" string="Rental Price" domain="[('sync_type','=','rental_price')]"/>
                    <filter name="filter_product_template" string="Product Template" domain="[('sync_type','=','product_template')]"/>
                    <separator/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'sync_type'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'sync_date'}"/>
                </search>
            </field>
        </record>

        <!-- report list view -->
        <record id="view_sync_report_tree" model="ir.ui.view">
            <field name="name">prosync.report.tree</field>
            <field name="model">prosync.report</field>
            <!-- <field name="context">{'group_by': 'sync_date'}</field> -->
            <field name="arch" type="xml">
                <list decoration-success="status == 'success'" 
                    decoration-warning="status == 'warning'" 
                    decoration-danger="status == 'failure'">
                    <field name="sync_type" string="Type"/>
                    <field name="name" string="Report Name"/>
                    <field name="status" string="Status"/>
                    <field name="sync_date" string="Sync Date" />
                    <field name="start_time" string="Start Date &amp; Time"/>
                    <field name="end_time" string="End Date &amp; Time"/>
                    <field name="duration" string="Sync Duration (minutes)"/>
                </list>
            </field>
        </record>

        <!-- report record view -->
        <record id="view_sync_report_form" model="ir.ui.view">
            <field name="name">prosync.report.form</field>
            <field name="model">prosync.report</field>
            <field name="arch" type="xml">
                <form string="Sync Report">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="status" />
                            <field name="sync_type" />
                            <field name="sync_date" />
                            <field name="start_time" />
                            <field name="end_time" />
                            <field name="duration" />
                        </group>
                        <notebook>
                            <page string="Updated items">
                                <field name="report_text" 
                                    widget="text_area" 
                                    style="width: 100%; height: 300px;" 
                                    placeholder="No report yet..." />
                            </page>
                            <page string="Warnings">
                                <field name="warning_text"
                                    widget="text_area"
                                    style="width: 100%; height: 300px;"
                                    placeholder="No warnings..." />
                            </page>
                            <page string="Errors">
                                <field name="error_text"
                                    widget="text_area"
                                    style="width: 100%; height: 300px;"
                                    placeholder="No errors..." />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sync_report_form_run_btn" model="ir.ui.view">
            <field name="name">prosync.report.form.run.btn</field>
            <field name="model">prosync.report</field>
            <field name="inherit_id" ref="prosync.view_sync_report_form"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="before">
                    <header>
                        <button type="action"
                            name="%(prosync.ir_actions_server_run_prosync_now)d"
                            class="oe_highlight"
                            string="Run ProSync now"/>
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
