<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- action -->
    <record id="action_sync_report_tree" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">prosync.report</field>
        <field name="view_mode">tree,form</field>
        <!-- <field name="context">{'group_by': 'sync_date'}</field> -->
    </record>

    <!-- app dashboard menu -->
    <menuitem
        id="menu_sync_reports"
        name="Sync Reports"
        sequence="10"
        action="action_sync_report_tree"
        parent=""
        groups="base.group_no_one" /> <!-- Visible in developer mode only -->

    <!-- report list view -->
    <record id="view_sync_report_tree" model="ir.ui.view">
        <field name="name">prosync.report.tree</field>
        <field name="model">prosync.report</field>
        <field name="context">{'group_by': 'sync_date'}</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'success'" 
                  decoration-warning="status == 'warning'" 
                  decoration-danger="status == 'failure'">
                <field name="name" string="Report Name"/>
                <field name="status" string="Status"/>
                <field name="sync_date" string="Sync Date" />
                <field name="start_time" string="Start Date &amp; Time"/>
                <field name="end_time" string="End Date &amp; Time"/>
                <field name="duration" string="Sync Duration (minutes)"/>
            </tree>
        </field>
    </record>

    <!-- report record view -->
    <record id="view_sync_report_form" model="ir.ui.view">
        <field name="name">prosync.report.form</field>
        <field name="model">prosync.report</field>
        <field name="arch" type="xml">
            <form string="Sync Report">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="status" />
                        <field name="start_time" />
                        <field name="end_time" />
                        <field name="duration" />
                    </group>
                    <notebook>
                        <!-- <page string="Error Report">
                            <field name="error_report" 
                                widget="text_area" 
                                style="width: 100%; height: 200px;" 
                                placeholder="No errors yet..." />
                        </page>
                        <page string="Items Updated">
                            <field name="items_updated" 
                                widget="text_area" 
                                style="width: 100%; height: 200px;" 
                                placeholder="No items updated..." />
                        </page> -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
