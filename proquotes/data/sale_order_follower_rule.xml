<odoo>
  <record id="sale_order_portal_follower_rule" model="ir.rule">
    <field name="name">Portal: Sale Order Follower Access</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">['|', ('partner_id','child_of',[user.partner_id.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
