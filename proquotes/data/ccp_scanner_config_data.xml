        <!-- BLK ARC Scanner -->
        <record id="ccp_scanner_blk_arc" model="ccp.scanner.config">
            <field name="name">BLK ARC</field>
            <field name="internal_key">blk_arc</field>
            <field name="title_template_en">Select CCP Type for BLK ARC</field>
            <field name="title_template_fr">Sélectionner le type CCP pour BLK ARC</field>
            <field name="product_search_patterns">{period} {scanner_name} Laser Scanner CCP {ccp_type}
{period} {scanner_name} CCP {ccp_type}
CCP {ccp_type} {scanner_name} {period}</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
            <field name="type_ids" eval="[(6, 0, [ref('ccp_type_basic'), ref('ccp_type_blue'), ref('ccp_type_bronze'), ref('ccp_type_silver'), ref('ccp_type_gold')])]"/>
            <field name="period_ids" eval="[(6, 0, [ref('ccp_period_1yr'), ref('ccp_period_2yr'), ref('ccp_period_3yr'), ref('ccp_period_5yr')])]"/>
        </record>

