<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Add a "Make single choice" item to the section options dropdown, placed
         right before "Add a note" (i.e. just after the native "Set Optional"
         item). Anchoring on the community "Add a note" icon (fa-sticky-note-o)
         keeps the xpath stable regardless of the Enterprise "Set Optional" item. -->
    <t t-name="proquotes.single_choice_item"
       t-inherit="sale.ListRenderer.RecordRow"
       t-inherit-mode="extension">
        <xpath expr="//DropdownItem[i[hasclass('fa-sticky-note-o')]]" position="before">
            <DropdownItem
                t-if="record.data.display_type === 'line_section' or record.data.display_type === 'line_subsection'"
                onSelected="() => this.onToggleSingleChoice(record)"
                attrs="{ 'class': (record.data.is_optional and not record.data.x_single_choice) ? 'disabled' : '' }">
                <i class="me-1 fa fa-fw fa-dot-circle-o"/>
                <span t-if="record.data.x_single_choice">Unset Single Choice</span>
                <span t-else="">Set Single Choice</span>
            </DropdownItem>
        </xpath>
    </t>

</templates>
