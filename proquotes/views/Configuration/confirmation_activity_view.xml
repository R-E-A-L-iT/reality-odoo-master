<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── List View ──────────────────────────────────────────────────────── -->
    <record id="confirmation_activity_template_view_list" model="ir.ui.view">
        <field name="name">proquotes.confirmation.activity.template.view.list</field>
        <field name="model">proquotes.confirmation.activity.template</field>
        <field name="arch" type="xml">
            <tree string="Confirmation Activity Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="activity_type_id"/>
                <field name="user_id"/>
                <field name="days_after_confirmation" string="Days After"/>
                <field name="order_type"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ─── Form View ──────────────────────────────────────────────────────── -->
    <record id="confirmation_activity_template_view_form" model="ir.ui.view">
        <field name="name">proquotes.confirmation.activity.template.view.form</field>
        <field name="model">proquotes.confirmation.activity.template</field>
        <field name="arch" type="xml">
            <form string="Confirmation Activity Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Activity Summary"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Prepare delivery, Send invoice…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Assignment">
                            <field name="activity_type_id"/>
                            <field name="user_id"/>
                            <field name="days_after_confirmation"/>
                            <field name="order_type"/>
                            <field name="sequence"/>
                        </group>
                    </group>

                    <group string="Note / Instructions">
                        <field name="description" nolabel="1"
                               placeholder="Optional detailed instructions for the assignee…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Search View ────────────────────────────────────────────────────── -->
    <record id="confirmation_activity_template_view_search" model="ir.ui.view">
        <field name="name">proquotes.confirmation.activity.template.view.search</field>
        <field name="model">proquotes.confirmation.activity.template</field>
        <field name="arch" type="xml">
            <search string="Confirmation Activity Templates">
                <field name="name"/>
                <field name="user_id"/>
                <field name="activity_type_id"/>
                <filter string="Active"   name="active"   domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Sales Only"   name="type_sale"   domain="[('order_type', '=', 'sale')]"/>
                <filter string="Rentals Only" name="type_rental" domain="[('order_type', '=', 'rental')]"/>
                <filter string="Both"         name="type_both"   domain="[('order_type', '=', 'both')]"/>
                <group expand="0" string="Group By">
                    <filter string="Assigned To"    name="group_user"          context="{'group_by': 'user_id'}"/>
                    <filter string="Activity Type"  name="group_activity_type" context="{'group_by': 'activity_type_id'}"/>
                    <filter string="Apply To"       name="group_order_type"    context="{'group_by': 'order_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Window Action ──────────────────────────────────────────────────── -->
    <record id="confirmation_activity_template_action" model="ir.actions.act_window">
        <field name="name">Confirmation Activity Templates</field>
        <field name="res_model">proquotes.confirmation.activity.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first confirmation activity template
            </p>
            <p>
                Each template defines one activity that will be created automatically
                whenever a sales or rental quote is confirmed.  Add one template per
                employee or task so every team member receives their own activity
                the moment an order is confirmed.
            </p>
        </field>
    </record>

    <!-- ─── Menu Items ─────────────────────────────────────────────────────── -->
    <!--
        Adds "Confirmation Activities" under Sales > Configuration, alongside
        the existing CCP Configuration entries.
    -->
    <menuitem id="menu_confirmation_activities"
              name="Confirmation Activities"
              parent="sale.menu_sale_config"
              action="confirmation_activity_template_action"
              sequence="55"/>

</odoo>
