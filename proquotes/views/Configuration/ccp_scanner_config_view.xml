<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="ccp_scanner_config_view_tree" model="ir.ui.view">
        <field name="name">ccp.scanner.config.view.tree</field>
        <field name="model">ccp.scanner.config</field>
        <field name="arch" type="xml">
            <list string="CCP Scanners">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="internal_key"/>
                <field name="section_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="ccp_scanner_config_view_form" model="ir.ui.view">
        <field name="name">ccp.scanner.config.view.form</field>
        <field name="model">ccp.scanner.config</field>
        <field name="arch" type="xml">
            <form string="CCP Scanner">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="internal_key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="section_name" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration" name="configuration">
                            <group>
                                <group string="Title Templates">
                                    <field name="title_template_en" placeholder="Select CCP Type for {scanner_name}"/>
                                    <field name="title_template_fr" placeholder="Sélectionner le type CCP pour {scanner_name}"/>
                                </group>
                            </group>
                            <group string="Product Search Patterns">
                                <field name="product_search_patterns" nolabel="1" widget="text" placeholder="One pattern per line. Use placeholders: {scanner_name}, {ccp_type}, {period}"/>
                            </group>
                        </page>
                        <page string="CCP Types" name="types">
                            <field name="type_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="display_name"/>
                                    <field name="icon"/>
                                    <field name="color" widget="color"/>
                                </list>
                            </field>
                        </page>
                        <page string="Time Periods" name="periods">
                            <field name="period_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="display_name_en"/>
                                    <field name="display_name_fr"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="ccp_scanner_config_view_search" model="ir.ui.view">
        <field name="name">ccp.scanner.config.view.search</field>
        <field name="model">ccp.scanner.config</field>
        <field name="arch" type="xml">
            <search string="CCP Scanners">
                <field name="name"/>
                <field name="internal_key"/>
                <field name="section_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="ccp_scanner_config_action" model="ir.actions.act_window">
        <field name="name">CCP Scanners</field>
        <field name="res_model">ccp.scanner.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new CCP Scanner Configuration
            </p>
            <p>
                Configure scanners (e.g., RTC360, BLK ARC, PEGASUS TRK) with their available CCP types and time periods.
                Each scanner can have custom title templates and product search patterns.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ccp_scanner_config"
              name="CCP Scanners"
              parent="menu_ccp_configuration"
              action="ccp_scanner_config_action"
              sequence="30"/>
</odoo>
