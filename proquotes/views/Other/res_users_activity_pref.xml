<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-user activity-email preference on the user form. This instance does
         NOT have base.view_users_form_simple_modify, so we extend the main user
         form (base.view_users_form) — which the "My Preferences" dialog uses
         here too. Anchored on company_id, a field proven present in this
         deployment (see proquotes/views/Other/res_user.xml). -->
    <record id="view_users_form_activity_email" model="ir.ui.view">
        <field name="name">res.users.form.activity.email</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="activity_send_email"/>
            </field>
        </field>
    </record>
</odoo>
