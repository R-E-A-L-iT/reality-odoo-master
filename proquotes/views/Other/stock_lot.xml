<odoo>
    <record id="view_stock_lot_form_inherit_pdf" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.pdf</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="document_pdf" filename="document_pdf_filename"/>
            </xpath>
        </field>
    </record>
</odoo>
