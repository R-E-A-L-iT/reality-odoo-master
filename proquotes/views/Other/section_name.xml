<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<!-- Return Appropriate result based on SNAME -->
	<template name="Section Bilingual Names" id="section_name_resolution">
		<t t-set="sname" t-value="sname" />
		<!-- The legacy text-only rental section shorthands (rental_equipment /
		     rental_accessories / rental_software) were removed: section titles now
		     come from the per-line translation system (section_name_translations).
		     A section still literally named "#rental_*" falls through to the final
		     else and renders its raw name. -->
		<t t-if="sname == 'existing_sub'">
			<t t-if="language == 'en_CA' or language == 'en_US'">Existing Subscription</t>
			<t t-if="language == 'fr_CA'">Abonnement(s) existant(s)</t>
			<t t-if="language == 'es_ES'">Suscripción existente</t>
		</t>
		<t t-elif="sname[:13] == 'product_subs+'">
			<t t-set="labelList" t-value="sname.split('+')" />
			<t t-set="name" t-value="labelList[1]" />

			<t t-if="language == 'en_CA' or language == 'en_US'" t-out="'Additional' + name + 'Subscriptions'" />
			<t t-if="language == 'fr_CA'" t-out="'Abonnement(s) - ' + name + ' - additionnel(s)'" />
			<t t-if="language == 'es_ES'" t-out="'Suscripción(es) adicional(es) de ' + name" />
		</t>
		<t t-elif="sname[:16] == 'reality_capture+'">
			<t t-set="labelList" t-value="sname.split('+')" />
			<t t-set="name" t-value="labelList[1]" />

			<t t-if="language == 'en_CA' or language == 'en_US'" t-out="'REALITY CAPTURE' + name" />
			<t t-if="language == 'fr_CA'" t-out="name + ' CAPTURE DE RÉALITÉ'" />
			<t t-if="language == 'es_ES'" t-out="'CAPTURA DE LA REALIDAD' + name" />
		</t>
		<t t-elif="sname[:10] == 'translate+'">
			<t t-set="labelList" t-value="sname.split('+')" />
			<t t-set="english_content" t-value="labelList[1]" />
			<t t-set="french_content" t-value="labelList[2]" />

			<t t-if="language == 'en_CA' or language == 'en_US' or language == 'es_ES'" t-out="english_content" />
			<t t-if="language == 'fr_CA'" t-out="french_content" />
		</t>
		<t t-elif="sname[:9] == 'ccplabel+'">
			<t t-set="labelList" t-value="sname.split('+')" />
			<t t-set="id" t-value="labelList[1]" />
			<t t-set="name" t-value="labelList[2]" />

			<t t-set="day" t-value="" />
			<t t-set="monthNum" t-value="0" />
			<t t-set="year" t-value="" />
			<t t-if="len(labelList) == 4">
				<t t-set="date" t-value="labelList[3].split('-')" />
				<t t-set="year" t-value="date[0]" />
				<t t-set="monthNum" t-value="date[1]" />
				<t t-set="day" t-value="date[2]" />
				<t t-if="language == 'en_CA' or language == 'en_US'">
					<t t-set="monthList" t-value="['', 'January', 'Febuary', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']" />
					<t t-out="str(name) + ' (' + str(id) + ') - Expiration: ' + monthList[int(monthNum)] + ' ' + str(day) + ', ' + str(year)" />
				</t>
				<t t-elif="language == 'fr_CA'">
					<t t-set="monthList" t-value="['', 'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre']" />
					<t t-out="str(name) + ' (' + str(id) + ') - Expiration: ' + str(day) + ' ' + monthList[int(monthNum)] + ', ' + str(year)" />
				</t>
				<t t-elif="language == 'es_ES'">
					<t t-set="monthList" t-value="['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']" />
					<t t-out="str(name) + ' (' + str(id) + ') - Vencimiento: ' + str(day) + ' de ' + monthList[int(monthNum)] + ' de ' + str(year)" />
				</t>
			</t>
			<t t-else="">
				<t t-if="language == 'en_CA' or language == 'en_US'" t-out="str(name) + ' (' + str(id) + ')'" />
				<t t-elif="language == 'fr_CA'" t-out="str(name) + ' (' + str(id) + ')'" />
				<t t-elif="language == 'es_ES'" t-out="str(name) + ' (' + str(id) + ')'" />
			</t>

		</t>
		<t t-elif="sname[:15] == 'ccp_selection_'">
			<!-- CCP Selection Section Name Resolution -->
			<t t-set="scanner_id" t-value="sname[15:]" />

			<t t-if="scanner_id == 'blkarc'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for BLK ARC</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour BLK ARC</t>
			</t>
			<t t-elif="scanner_id == 'pegasustrk'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for PEGASUS TRK</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour PEGASUS TRK</t>
			</t>
			<t t-elif="scanner_id == 'blk2fly'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for BLK2FLY</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour BLK2FLY</t>
			</t>
			<t t-elif="scanner_id == 'blk2go'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for BLK2GO</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour BLK2GO</t>
			</t>
			<t t-elif="scanner_id == 'blk2gopulse'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for BLK2GO PULSE</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour BLK2GO PULSE</t>
			</t>
			<t t-elif="scanner_id == 'rtc360'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for RTC360</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour RTC360</t>
			</t>
			<t t-elif="scanner_id == 'pseries'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for P-SERIES</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour P-SERIES</t>
			</t>
			<t t-elif="scanner_id == 'blk360'">
				<t t-if="language == 'en_CA' or language == 'en_US'">Select CCP Type for BLK360</t>
				<t t-elif="language == 'fr_CA'">Sélectionner le type CCP pour BLK360</t>
			</t>
			<t t-else="">
				<!-- Fallback if scanner_id not recognized -->
				<t t-out="sname" />
			</t>
		</t>
		<t t-else="">
			<t t-out="sname" />
		</t>
	</template>
</odoo>