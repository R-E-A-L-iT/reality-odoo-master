<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rental_order_wizard_form_inherit_serial_domain" model="ir.ui.view">
        <field name="name">rental.order.wizard.form.inherit.serial.domain</field>
        <field name="model">rental.order.wizard</field>
        <field name="inherit_id" ref="sale_renting.rental_order_wizard_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='rental_wizard_line_ids']/list/field[@name='product_id']" position="after">
                <field name="allowed_lot_ids" column_invisible="True"/>
            </xpath>

        </field>
    </record>

</odoo>