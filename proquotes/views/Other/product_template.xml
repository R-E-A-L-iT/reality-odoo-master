<odoo>
    <record id="view_product_template_form_inherit_proquotes" model="ir.ui.view">
        <field name="name">product.template.form.inherit.proquotes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <!-- Replace the rental pricing table inside the 'Rental prices' tab -->
            <xpath expr="//page[@name='pricing']/group/group[@name='pricing']" position="replace">
                <group name="pricing" string="Pricing">
                    <field name="default_rental_behaviour"/>
                    
                    <field name="product_pricing_ids" nolabel="1" colspan="2" invisible="['default_rental_behaviour', '=', False]"/>
                    
                    <field name="rental_base" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="['default_rental_behaviour', '=', True]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
