<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_preconfigured_section" model="ir.actions.act_window">
        <field name="name">Preconfigured Sections</field>
        <field name="res_model">preconfigured.section</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>
                Create and manage preconfigured sections for sales orders. Each section contains multiple products.
            </p>
        </field>
    </record>

    <menuitem id="menu_preconfigured_section_root" name="Preconfigured Sections"
              parent="sale.menu_sale_config" sequence="50"
              action="action_preconfigured_section"/>

    <record id="view_preconfigured_section_tree" model="ir.ui.view">
        <field name="name">preconfigured.section.tree</field>
        <field name="model">preconfigured.section</field>
        <field name="arch" type="xml">
            <tree string="Preconfigured Sections">
                <field name="section_name"/>
                <field name="section_description"/>
                <field name="number_of_products"/>
            </tree>
        </field>
    </record>

    <record id="view_preconfigured_section_form" model="ir.ui.view">
        <field name="name">preconfigured.section.form</field>
        <field name="model">preconfigured.section</field>
        <field name="arch" type="xml">
            <form string="Preconfigured Section">
                <sheet>
                    <group>
                        <field name="section_name"/>
                        <field name="section_description"/>
                        <field name="number_of_products" readonly="1"/>
                    </group>
                    <group>
                         <field name="product_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="id" invisible="1"/>
                                <field name="name"/>
                                <field name="optional"/>
                                <field name="selected"/>
                                <field name="quantityLocked"/>
                                <field name="price_unit"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--  Sale Order  -->

    <record id="view_order_form_inherit_preconfigured_section" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.preconfigured.section</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Preconfigured Sections">
                    <field name="preconfigured_section_ids" widget="many2many_list" nolabel="1">
                        <tree editable="bottom">
                            <field name="section_name"/>
                            <field name="section_description"/>
                            <field name="number_of_products"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
