<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_proquotes" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.proquotes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Order Confirmation Email Template field after cart recovery template -->
            <xpath expr="//div[@id='cart_recovery_email_template']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="order_confirmation_email_template">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="confirmation_mail_template" string="Order Confirmation Email Template"/>
                        <div class="text-muted">
                            Email template used when order is confirmed from this website
                        </div>
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="confirmation_mail_template" class="col-lg-3 o_light_label"/>
                                <field name="confirmation_mail_template" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
