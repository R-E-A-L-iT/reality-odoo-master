<odoo>
    <record id="view_stock_move_line_form_inherit_add_pdf" model="ir.ui.view">
        <field name="name">stock.view.move.form.inherit.add.pdf</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <button name="action_open_lot_record"
                        type="object"
                        string="Add PDF (software only)"
                        class="btn-secondary"
                        attrs="{'invisible': [('lot_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>

    