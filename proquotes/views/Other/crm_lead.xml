<odoo>
  <data>
    <record id="view_crm_lead_form_reveal_ip_public" model="ir.ui.view">
      <field name="name">crm.lead.form.reveal_ip_public.domain</field>
      <field name="model">crm.lead</field>
      <field name="inherit_id" ref="crm.crm_lead_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='date_open']" position="after">
          <field name="reveal_ip_public" invisible="1"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>