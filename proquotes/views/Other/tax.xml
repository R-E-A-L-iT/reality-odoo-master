<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 replaced account.tax_groups_totals with document_tax_totals_template.
         The group name lives on tax_group['group_name']. -->
    <template id="proquote_tax_display" name="Proquotes Tax Display" inherit_id="account.document_tax_totals_template">
        <xpath expr="//t[@t-if=&quot;same_tax_base or tax_group['display_base_amount_currency'] is False&quot;]/td[1]/span" position="replace">
            <t t-call="proquotes.tax_group_name_content"/>
        </xpath>
        <xpath expr="//t[@t-else='']/td[1]/span[1]" position="replace">
            <t t-call="proquotes.tax_group_name_content"/>
        </xpath>
    </template>

    <template name="tax_group_name_content" id="tax_group_name_content">
        <span>
            <t t-set="tax_label" t-value="tax_group['group_name'] or ''"/>
            <t t-if="doc != undefined" t-set="source" t-value="doc"/>
            <t t-elif="o != undefined" t-set="source" t-value="o"/>
            <t t-elif="sale_order != undefined" t-set="source" t-value="sale_order"/>
            <t t-else="" t-set="source" t-value="False"/>
            <span t-if="not source or (lang != 'fr_CA' and lang != undefined) or (lang == undefined and source.partner_id.lang != 'fr_CA')"
                  t-out="tax_label"/>
            <t t-else="">
                <span t-if="'GST' in tax_label or 'TPS' in tax_label">TPS</span>
                <span t-elif="'HST' in tax_label or 'TVH' in tax_label">TVH</span>
                <span t-elif="'QST' in tax_label or 'TVQ' in tax_label">TVQ</span>
                <span t-else="" t-out="tax_label"/>
            </t>
            <t t-if="source and source.company_id.id == 15">
                <span t-if="'GST' in tax_label or 'TPS' in tax_label"> 777 376 542 RT 0001</span>
                <span t-if="'HST' in tax_label or 'TVH' in tax_label"> 777 376 542 RT 0001</span>
                <span t-if="'QST' in tax_label or 'TVQ' in tax_label"> 1228256885 TQ 0001</span>
            </t>
            <t t-elif="source and source.company_id.id == 6">
                <span t-if="'GST' in tax_label or 'TPS' in tax_label"> 141 558 296 RT 0001</span>
                <span t-if="'QST' in tax_label or 'TVQ' in tax_label"> 1019504774 TQ 0001</span>
            </t>
            <t t-elif="source and source.company_id.id == 5">
                <span t-if="'GST' in tax_label or 'TPS' in tax_label"> 750 579 674 RT 0001</span>
            </t>
            <t t-elif="source and source.company_id.id == 7">
                <span t-if="'GST' in tax_label or 'TPS' in tax_label"> 750 147 936 RT 0001</span>
            </t>
        </span>
    </template>
</odoo>
