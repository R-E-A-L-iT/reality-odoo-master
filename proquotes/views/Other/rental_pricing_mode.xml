<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Add rental pricing mode checkboxes to the Rental prices tab on product.template.
        Inherits the sale_renting product form view extension.
    -->
    <record id="product_template_form_view_rental_pricing_mode" model="ir.ui.view">
        <field name="name">product.template.rental.pricing.mode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_renting.product_template_form_view_rental"/>
        <field name="arch" type="xml">
            <!-- Insert the pricing mode checkboxes at the top of the Rental prices tab -->
            <xpath expr="//page[@name='pricing']/group" position="before">
                <group string="Rental Price Mode">
                    <group>
                        <field name="use_default_rental_price" />
                        <field name="use_custom_rental_price" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
