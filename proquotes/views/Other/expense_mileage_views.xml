<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_expense_form_inherit_mileage" model="ir.ui.view">
        <field name="name">hr.expense.form.inherit.mileage</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group>
                    <field name="mileage"/>
                    <field name="mileage_reimbursement" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
