<odoo>
    <record id="view_picking_form_add_pdf_button" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.add.pdf</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_related_lots"
                        type="object"
                        string="Add PDF Licenses"
                        class="btn-secondary"
                        invisible="[('picking_type_code', '!=', 'incoming')]"/>
            </xpath>
        </field>
    </record>
</odoo>
