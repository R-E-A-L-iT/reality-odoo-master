<odoo>
    <record id="view_stock_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="hide_on_portal" string="Hide On Portal"/>
                <field name="rental_sale_order_id" string="Rental Order"
                       invisible="not rental_sale_order_id"
                       readonly="state == 'done'"/>
                <field name="rental_operation" string="Rental Operation"
                       invisible="not rental_operation"
                       readonly="state == 'done'"/>
            </xpath>

            <!-- carrier_id and carrier_tracking_ref are locked readonly after
                 validation by the base delivery module.  Override that so
                 shipping info can always be corrected after the fact. -->
            <xpath expr="//field[@name='carrier_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='carrier_tracking_ref']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
