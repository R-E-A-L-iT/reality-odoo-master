<odoo>
    <record id="view_stock_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_sign_wizard"
                        string="Sign"
                        type="object"
                        class="btn-primary"
                        invisible="rental_operation != 'pickup' or state != 'done' or signed_on"/>
                <button name="action_open_sign_wizard"
                        string="Signed ✓"
                        type="object"
                        class="btn-secondary"
                        disabled="1"
                        invisible="rental_operation != 'pickup' or not signed_on"/>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="hide_on_portal" string="Hide On Portal"/>
                <field name="rental_sale_order_id" string="Rental Order"
                       invisible="not rental_sale_order_id"
                       readonly="state == 'done'"/>
                <field name="rental_operation" string="Rental Operation"
                       invisible="not rental_operation"
                       readonly="state == 'done'"/>
                <field name="signed_by" string="Signed By" readonly="1"
                       invisible="not signed_by"/>
                <field name="signed_on" string="Signed On" readonly="1"
                       widget="datetime" invisible="not signed_on"/>
                <field name="signature" widget="image" readonly="1"
                       invisible="not signed_on"
                       options="{'size': [200, 100]}"/>
            </xpath>

            <!-- carrier_id and carrier_tracking_ref are locked readonly after
                 validation by the base delivery module.  Override that so
                 shipping info can always be corrected after the fact. -->
            <xpath expr="//field[@name='carrier_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='carrier_tracking_ref']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
