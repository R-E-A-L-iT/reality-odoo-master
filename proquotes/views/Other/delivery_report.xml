<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<template id="stock_report_delivery_has_serial_move_line_inherit"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[1]" position="replace">
            <td>
                <span t-field="move_line.product_id"/>
                <span class="description-root" t-raw="move_line.product_id.description_sale"
                      t-if="move_line.product_id.description_sale" style="color: #777;"/>
            </td>
        </xpath>
    </template>
    <template id="report_picking_inherit" inherit_id="stock.report_picking">
        <xpath expr="//table[@class='table table-sm']/tbody/tr/td[1]" position="replace">
            <td>
                <span t-field="ml.product_id.display_name"/><br/>
                <span t-field="ml.product_id.description_picking"/><br/>
                <span class="description-root" t-raw="ml.product_id.description_sale" t-if="ml.product_id.description_sale" style="color: #777;"/>
            </td>
        </xpath>
    </template>

	<template id="deliver" name="Proquotes Deliver" inherit_id="stock.report_delivery_document" priority="17">

		<!-- Translate Info Labels -->

		<xpath expr="//t[@t-set='address']" position="replace">
			<t t-set="address">
				<div name="partner_address">
				<t t-set="src" t-value="o.sale_id"/>
				<style>
					#addressTable, #addressTable * {
					color: #495057;
					background-color: #fff !important;
					margin-left: 0px;
					border-color: #fff !important;
					border-width: 0px !important;
					border-style: none !important;
					}
				</style>
				<table id="addressTable" style="border-style: collapse !important;" border="0">
					<tr>
					<td colspan="100">
						<h3 t-if="src.partner_id.parent_id != False" t-field="src.partner_id.parent_id.name"/>
						<h3 t-field="src.partner_id.name"/>
					</td>
					</tr>
					<tr>
					<td style="display: block; float: left; border-style: hidden !important; margin-right: 30px;">
						<h5 t-if="src.partner_id.lang == 'fr_CA'" style="color: #db0d0d" if="src.partner_id.id != src.partner_shipping_id.id">Facturer à</h5>
						<h5 t-elif="src.partner_id.lang == 'es_ES'" style="color: #db0d0d" if="src.partner_id.id != src.partner_shipping_id.id">Facturar a</h5>
						<h5 t-else="" style="color: #db0d0d" if="src.partner_id.id != src.partner_shipping_id.id">Bill To</h5>
						<span t-field="src.partner_id.name"/><br/>
						<span t-field="src.partner_id.street"/><br/>
						<span t-if="src.partner_id.city != False" t-out="src.partner_id.city + ','"/>
						<span t-esc="src.partner_id.state_id.code"/>
						<span t-field="src.partner_id.zip"/>
						<span t-field="src.partner_id.country_id.name"/><br/>
						<span t-field="src.partner_id.phone"/><br/>
					</td>
					<td t-if="src.partner_id.id != src.partner_shipping_id.id"
						style="margin-left: 100px; display: block; float: right; border-style: hidden !important;">
						<h5 t-if="src.partner_id.lang == 'fr_CA'" style="color: #db0d0d;">Envoyer à</h5>
						<h5 t-elif="src.partner_id.lang == 'es_ES'" style="color: #db0d0d;">Enviar a</h5>
						<h5 t-else="" style="color: #db0d0d;">Ship To</h5>
						<span t-field="src.partner_id.name"/><br/>
						<span t-field="src.partner_shipping_id.street"/><br/>
						<span t-if="src.partner_shipping_id.city != False" t-out="src.partner_shipping_id.city + ','"/>
						<span t-esc="src.partner_shipping_id.state_id.code"/>
						<span t-field="src.partner_shipping_id.zip"/>
						<span t-field="src.partner_shipping_id.country_id.name"/><br/>
						<span t-field="src.partner_shipping_id.phone"/>
					</td>
					</tr>
				</table>
				</div>
			</t>
		</xpath>

		<xpath expr="//t[@t-set='information_block']" position="replace" />

		<!-- Add Description -->
		<xpath expr="//tr[@t-foreach=&quot;lines&quot;]//td[1]//span" position="after">
			<style>
				td {
				border-style: solid;
				}

				.description-root, .description-root *{
				font-size: 0.75rem
				margin-top: 0px !important;
				margin-bottom: 0px !important;
				}
			</style>
			<t t-if="str(move.name) != str(move.product_id.description_sale)">
				<span class="description-root">
					<span t-raw="move.name" />
				</span>
			</t>
			<br />
			<span class="description-root" t-raw="move.product_id.description_sale" style="color: #777;" />
		</xpath>

		<!-- Add Detail Lines -->
		<xpath expr="//div[@t-else=&quot;&quot;]" position="replace">
			<div>
				<span style="height: 40px"> PO #:</span>
				<span style="border-bottom: solid !important; width:500px !important;">
					<span style="color: #fff;">________________________________________</span>
				</span>
				<br />
				<br />
				<span style="height: 40px"> Signature:</span>
				<span style="border-bottom: solid !important; width:500px !important;">
					<span style="color: #fff;">____________________________________</span>
				</span>
				<br />
				<br />
				<span style="height: 40px"> Date:</span>
				<span style="border-bottom: solid !important; width:500px !important;">
					<span style="color: #fff;">________________________________________</span>
				</span>
				<br />
				<br />
				<br />

			</div>
		</xpath>
	</template>
</odoo>