<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_order_form_PO"
		model="ir.ui.view">
		<field name="name">purchase.order.form</field>
		<field
			name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='date_approve']" position="attributes">
				<attribute name="readonly">0</attribute>
			</xpath>
			<xpath expr="//field[@name=&quot;currency_id&quot;]"
				position="after">
				<field name="footer_id" invisible="0" domain="['&amp;', ('active', '=', True),('doc_class', '=', 'preview'), ('document_type', '=', 'footer'), '|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]" />
			</xpath>
		</field>
	</record>
</odoo>