<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_quote_real" model="ir.ui.view">
        <field name="name">sale.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rental_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not is_rental_order or rental_transfer_count == 0">
                    <field name="rental_transfer_count" widget="statinfo" string="Rental Transfers"/>
                </button>
            </xpath>

            <xpath expr="//field[@name=&quot;partner_id&quot;]" position="attributes">
                <attribute name="string">Business</attribute>
            </xpath>

            <!-- Return button: sale_renting already handles its own visibility -->
            <xpath expr="//button[@name='action_open_return']" position="attributes">
                <attribute name="invisible">rental_status != 'return'</attribute>
                <attribute name="class">btn-primary</attribute>
            </xpath>

            <!-- pricelist filter -->
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <!-- Default domain for regular orders -->
                <attribute name="domain">[('name', 'ilike', '🇨🇦'), ('name', 'ilike', '🇺🇸')]</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_order_template_id']" position="before">
                <field name="allowed_sale_order_template_ids" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_sale_order_template_ids)]</attribute>
            </xpath>

            <!-- make update pricelist button permanent -->
            <xpath expr="//form[@class='o_sale_order']//button[@name='action_update_prices']" position="attributes">
                <attribute name="invisible"/>
            </xpath>

            <xpath expr="//field[@name='rental_start_date']" position="before">
                <field name="pickup_date" invisible="not is_rental_order"/>
            </xpath>

            <xpath expr="//group[@name=&quot;partner_details&quot;]" position="after">
                <field name="is_renewal" invisible="1"/>
                <!-- Renewal Quotes Added Products -->
                <!-- ('active', '=', True), filter can't be added without adding sync module dependency, but adding sync module dependency creates more errors for some reason -->
                <field name="renewal_product_items" invisible="not is_renewal" domain="[('owner', '=', partner_id), ('company_id', '=', 1)]">
                    <list>
                        <field name="name"></field>
                        <field name="product_id"></field>
                        <field name="expire"/>
                        <field name="formated_label"></field>
                    </list>
                </field>


                <!-- Rental Info -->
                <group name="custom_quote_details">

                    <field name="customer_po_number" invisible="0"/>
                    <field name="manual_invoice_status"/>
                    <!-- approve_financing is now selected via the Quote Builder
                         "Other Blocks" list; kept on the model for back-compat. -->
                </group>
            </xpath>

            <!-- Always show the Quote Builder tab. Natively it is hidden when no
                 eligible document exists (invisible="not available_quotation_document_ids"),
                 and since _compute_available_quotation_document_ids strips our
                 "preview" docs, that condition only ever counted the Report (PDF)
                 docs — so the tab vanished whenever no report header/footer was
                 eligible. We want the preview selectors reachable at all times. -->
            <xpath expr="//page[@name='pdf_quote_builder']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <!-- Preview (online quote) header/footer selectors, shown in the
                 native Quote Builder tab next to the Report (PDF) header/footer
                 widget. These are quotation.document records of the "preview"
                 class (a link/URL), kept separate from the uploaded PDF docs.
                 Rendered with <separator> headings + the radio widget so they
                 read like the native "Header"/"Footer" pickers (bold heading
                 above a selectable list) instead of a labelled dropdown. -->
            <xpath expr="//page[@name='pdf_quote_builder']" position="inside">
                <div name="preview_header_footer" class="mt-4">
                    <separator string="Preview Header (online quote)"/>
                    <field name="header_id" nolabel="1" widget="selection_badge"
                           domain="['&amp;', '&amp;', ('active', '=', True), ('doc_class', '=', 'preview'), ('document_type', '=', 'header'), '|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]"/>
                    <separator string="Preview Footer (online quote)"/>
                    <field name="footer_id" nolabel="1" widget="selection_badge"
                           domain="['&amp;', '&amp;', ('active', '=', True), ('doc_class', '=', 'preview'), ('document_type', '=', 'footer'), '|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]"/>
                    <separator string="Other Blocks (online quote)"/>
                    <field name="preview_block_ids" nolabel="1" widget="many2many_checkboxes"/>
                </div>
            </xpath>

            <xpath expr="//control" position="after">
                <!-- Loaded so the "Translate" section action + language-aware
                     section labels (section_translate.js) can read/write it. -->
                <field name="section_name_translations" column_invisible="True"/>
            </xpath>


            <xpath expr="//field[@name=&quot;product_uom_qty&quot;][@decoration-info=&quot;(not display_type and invoice_status == 'to invoice')&quot;]"
                   position="before">
                <field name="applied_name" invisible="0" optional="hide" readonly="state in ('sale', 'done', 'cancel')"/>
            </xpath>

            <!-- Make quantity readonly when order is confirmed -->
            <xpath expr="//field[@name=&quot;product_uom_qty&quot;][@decoration-info=&quot;(not display_type and invoice_status == 'to invoice')&quot;]"
                   position="attributes">
                <attribute name="readonly">state in ('sale', 'done', 'cancel')</attribute>
            </xpath>

            <!-- Custom Line Fields -->
            <xpath expr="//field[@name=&quot;product_uom_qty&quot;][@decoration-info=&quot;(not display_type and invoice_status == 'to invoice')&quot;]"
                   position="after">
                <field name="quantityLocked" column_invisible="1" readonly="state in ('sale', 'done', 'cancel')"/>
                <field name="is_quantityLocked" invisible="0" readonly="state in ('sale', 'done', 'cancel')"/>
                <field name="variant" invisible="1" optional="hide"/>
                <field name="hiddenSection" invisible="1" optional="hide"/>
                <!-- Single-choice section flags (drive the green row decoration below). -->
                <field name="x_single_choice" column_invisible="1"/>
                <field name="x_single_choice_member" column_invisible="1"/>
                <!-- Optional-section membership + customer-hidden preset quantity.
                     Preset is the qty a member takes when the customer ticks it on
                     the online quote (shown greyed while unselected). -->
                <field name="x_optional_section_id" column_invisible="1"/>
                <field name="x_optional_member" column_invisible="1"/>
                <field name="x_preset_qty" optional="hide" readonly="state in ('sale', 'done', 'cancel')"/>
            </xpath>


            <!-- Line Display Default Limit + green highlight for single-choice
                 sections and their member product lines (parallels the native
                 optional purple, which is a text colour). -->
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="limit">150</attribute>
                <attribute name="decoration-success">x_single_choice or x_single_choice_member</attribute>
            </xpath>

            <!-- Widen Product and Description columns -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="width">200px</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="width">300px</attribute>
            </xpath>

            <!-- Products Owned By Customer -->
            <xpath expr="//page[@name=&quot;other_information&quot;]" position="before">
                <page string="Customer Products" name="customer_products" invisible="0">
                    <group>
                        <field name="products" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="sku"/>
                                <field name="product_id"/>
                                <field name="expire"/>
                                <field name="formated_label"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

            <!--			commented due to the undefine-->
            <!--			<xpath expr="//button[@name='update_prices']" position="attributes">-->
            <!--				<attribute name="attrs">{'invisible': [('state', 'in', ['done','cancel'])]}</attribute>-->
            <!--			</xpath>-->

        </field>
    </record>

    <!-- hide_view_order_form_proquotes REMOVED: its only job was
         <xpath expr="//page[@name='optional_products']" position="replace"/> on
         sale_management.sale_order_form_quote. Odoo 19 deleted that page, so the
         xpath failed and the view was permanently auto-deactivated. The page it
         hid no longer exists, so the whole record is obsolete. -->

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <field name="pricelist_id" position="attributes">
                <attribute name="domain">[('name', 'not ilike', 'default')]</attribute>
            </field>
        </field>
    </record>
</odoo>