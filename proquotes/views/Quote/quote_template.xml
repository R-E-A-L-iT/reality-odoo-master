<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form" model="ir.ui.view">
        <field name="name">sale.order_template_view_form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//group[@name='sale_info']" position="after">
                <group string="Defaults for Quotes">
                    <field name="header_id"
                           domain="[('active', '=', True), ('doc_class', '=', 'preview'), ('document_type', '=', 'header')]"/>
                    <field name="preview_block_ids" widget="many2many_checkboxes"/>
                </group>
            </xpath>

            <xpath expr="//control" position="after">
                <!-- Loaded so the section "Translate" dialog can read/write it. -->
                <field name="section_name_translations" column_invisible="1" />
            </xpath>

            <xpath expr="//list//field[@name=&quot;product_uom_qty&quot;]" position="after">
                <field name="quantityLocked" invisible="0" />
                <field name="hiddenSection" invisible="1" />
                <field name="discount" widget="percentage" invisible="0" />
            </xpath>

            <xpath expr="//page[@name=&quot;optional_products&quot;]" position="replace">

            </xpath>

        </field>

    </record>

</odoo>