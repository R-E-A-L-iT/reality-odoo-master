<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_order_portal_content" name="Sales Order Portal Content" inherit_id="sale.sale_order_portal_content" priority="17">
        
        <!-- 
        
        variables 

        -->
        <xpath expr="//div[@id='introduction']" position="before">
            
            <t t-set="language" t-value="request.lang.code" />
            <t t-set="sale_order" t-value="sale_order.with_context(lang=language)"/>

            <t t-if="sale_order.header_id.url[-4:] == '.jpg'" t-set="header_image" t-value="sale_order.header_id.url" />
            <t t-if="sale_order.header_id.url[-4:] == '.mp4'" t-set="header_video" t-value="sale_order.header_id.url" />

            <t t-set="company_name" t-value="sale_order.company_id.name"/>
        
        </xpath>

        <!-- 
        
        quote header 
        
        -->

        <!-- remove sidebar -->
        <xpath expr="//span[@id='transaction_info']/div" position="replace" />

    </template>
</odoo>