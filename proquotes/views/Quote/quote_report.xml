<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="sale_order_pdf_content" name="Sales Order PDF Content" inherit_id="sale.report_saleorder_document" priority="17">

        <xpath expr="//t[@t-call=&quot;web.external_layout&quot;]" position="replace">

            <t t-call="web.external_layout">
                <t t-set="footer_url" t-value="doc.footer_id.url if doc.footer_id else False"/>
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-set="language" t-value="doc.partner_id.lang"/>
                <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                <div class="container-fluid">
                    <div style="background-color: #f0f0f0; padding: 10px; margin-bottom: 10px; width: 100%; border: none !important;">
                        <table style="width: 100%; border-collapse: collapse; border: none !important;">
                            <tr style="border: none !important;">
                                <!-- Invoice Address -->
                                <td style="width: 50%; vertical-align: top; padding-right: 25px; border: none !important;">
                                    <strong>
                                        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                                            <t t-if="language == 'fr_CA'">Adresse de facturation et de livraison:</t>
                                            <t t-elif="language == 'es_ES'">Dirección de facturación y envío:</t>
                                            <t t-else="">Invoicing and Shipping Address:</t>
                                        </t>
                                        <t t-else="">
                                            <t t-if="language == 'fr_CA'">Adresse de facturation:</t>
                                            <t t-elif="language == 'es_ES'">Dirección de facturación:</t>
                                            <t t-else="">Invoicing Address:</t>
                                        </t>
                                    </strong>

                                    <div t-field="doc.partner_invoice_id"
                                        t-options="{
                                            &quot;widget&quot;: &quot;contact&quot;,
                                            &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;],
                                            &quot;no_marker&quot;: True,
                                            &quot;phone_icons&quot;: True
                                        }"/>
                                </td>

                                <!-- Shipping Address -->
                                <td t-if="doc.partner_shipping_id != doc.partner_invoice_id"
                                    style="width: 50%; vertical-align: top; padding-left: 25px; border: none !important;">
                                    <strong>
                                        <t t-if="language == 'fr_CA'">Adresse de livraison:</t>
                                        <t t-elif="language == 'es_ES'">Dirección de envío:</t>
                                        <t t-else="">Shipping Address:</t>
                                    </strong>

                                    <div t-field="doc.partner_shipping_id"
                                        t-options="{
                                            &quot;widget&quot;: &quot;contact&quot;,
                                            &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;],
                                            &quot;no_marker&quot;: True,
                                            &quot;phone_icons&quot;: True
                                        }"/>
                                </td>

                                <!-- Empty second column when addresses are the same -->
                                <td t-if="doc.partner_shipping_id == doc.partner_invoice_id"
                                    style="width: 50%; vertical-align: top;">
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="page">
                    <div class="oe_structure"/>

                    <h2 t-if="language == 'fr_CA'" class="mt-4">
                        <span t-if="env.context.get('proforma', False) or is_pro_forma">Facture Pro-Forma # </span>
                        <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                        <span t-else="">Commande # </span>
                        <span t-field="doc.name">SO0000</span>
                    </h2>
                    <h2 t-elif="language == 'es_ES'" class="mt-4">
                        <span t-if="env.context.get('proforma', False) or is_pro_forma">Factura Proforma # </span>
                        <span t-elif="doc.state in ['draft','sent']">Cotización # </span>
                        <span t-else="">Orden # </span>
                        <span t-field="doc.name">SO0000</span>
                    </h2>
                    <h2 t-else="" class="mt-4">
                        <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                        <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                        <span t-else="">Order # </span>
                        <span t-field="doc.name">SO0000</span>
                    </h2>

                    <div class="row mt-4 mb-2" id="informations">
                        <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2" name="informations_reference">
                            <strong>Your Reference:</strong><br/>
                            <span class="m-0" t-field="doc.client_order_ref">SO0000</span>
                        </div>
                        <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date">
                            <div t-if="doc.state in ['draft', 'sent']">
                                <strong t-if="language == 'fr_CA'">Date de Quotation:</strong>
                                <strong t-elif="language == 'es_ES'">Fecha de Cotización:</strong>
                                <strong t-else="">Quotation Date:</strong>
                            </div>
                            <div t-else="">
                                <strong t-if="language == 'fr_CA'">Date de commande:</strong>
                                <strong t-elif="language == 'es_ES'">Fecha de la orden:</strong>
                                <strong t-else="">Order Date:</strong>
                            </div>
                            <span class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</span>
                        </div>
                        <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col-auto col-3 mw-100 mb-2" name="expiration_date">
                            <strong t-if="language == 'fr_CA'">Date D'expiration:</strong>
                            <strong t-elif="language == 'es_ES'">Fecha de expiración:</strong>
                            <strong t-else="">Expiration</strong><br/>
                            <span class="m-0" t-field="doc.validity_date">2023-12-31</span>
                        </div>
                        <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                            <strong t-if="language == 'fr_CA'">Vendeur:</strong>
                            <strong t-elif="language == 'es_ES'">Vendedor:</strong>
                            <strong t-else="">Salesperson:</strong><br/>
                            <span class="m-0" t-field="doc.user_id">Mitchell Admin</span>
                        </div>
                    </div>

                    <!-- Is there a discount on at least one line? -->
                    <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                    <div class="oe_structure"/>
                    <table class="table table-sm o_main_table table-borderless mt-4">
                        <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                        <thead style="display: table-row-group">
                            <tr>
                                <th name="th_description" class="text-start">Description</th>
                                <th name="th_quantity" class="text-end" t-if="language == 'fr_CA'">Quantité</th>
                                <th name="th_quantity" class="text-end" t-elif="language == 'es_ES'">Cantidad</th>
                                <th name="th_quantity" class="text-end" t-else="">Quantity</th>
                                <th name="th_priceunit" class="text-end" t-if="language == 'fr_CA'">Prix ​​unitaire</th>
                                <th name="th_priceunit" class="text-end" t-elif="language == 'es_ES'">Precio unitario</th>
                                <th name="th_priceunit" class="text-end" t-else="">Unit Price</th>
                                <th name="th_discount" t-if="display_discount" class="text-end">
                                    <span t-if="language == 'fr_CA'">Rabais %</span>
                                    <span t-elif="language == 'es_ES'">Descuento %</span>
                                    <span t-else="">Disc.%</span>
                                </th>
                                <th name="th_taxes" class="text-end" t-if="language == 'fr_CA'">Taxes</th>
                                <th name="th_taxes" class="text-end" t-elif="language == 'es_ES'">Impuestos</th>
                                <th name="th_taxes" class="text-end" t-else="">Taxes</th>
                                <th name="th_subtotal" class="text-end" t-if="language == 'fr_CA'">
                                    <span>Montant</span>
                                </th>
                                <th name="th_subtotal" class="text-end" t-elif="language == 'es_ES'">
                                    <span>Monto</span>
                                </th>
                                <th name="th_subtotal" class="text-end" t-else="">
                                    <span>Amount</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">

                            <t t-set="current_subtotal" t-value="0"/>

                            <t t-foreach="lines_to_report" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else 'border_bottom'">
                                    <t t-if="not line.display_type and not line.x_is_rental_kit_component">
                                        <!-- <td name="td_name"><span t-field="line.name">Bacon Burger</span></td> -->
                                        <td name="td_name">
                                            <!-- Odoo 19 removed t-raw. Product name is plain text → t-field. -->
                                            <span t-field="line.product_id.name" />
                                            <!-- <span t-raw="line.name"/> -->
                                            <!-- <span dangerouslySetInnerHTML={{ __html: line.name }} /> -->
                                            <br/>
                                            <!-- <t t-set="description" t-value="line.name"/> -->
                                            <style>
                                                description-root, .description-root *{
                                                    font-size: .75rem;
                                                    margin-top: 0px !important;
                                                    margin-bottom: 0px !important;
                                                }

                                                .o_line_section, .border_bottom {
                                                    border-bottom: 1px solid #ccc !important;
                                                }
                                            </style>
                                            <!-- Odoo 19 removed t-raw; description_sale is intentionally
                                                 authored as HTML, so render it via the Markup-wrapping
                                                 helper with t-out (same path the portal uses). -->
                                            <div class="description-root" t-out="line._proquotes_description_sale_html()" style="color: #777;"/>
                                        </td>
                                        <td name="td_quantity" class="text-end">
                                            <span t-field="line.product_uom_qty">3</span>
                                            <!-- Odoo 19 renamed sale.order.line.product_uom -> product_uom_id. -->
                                            <span t-field="line.product_uom_id">units</span>
                                            <span t-if="line.product_packaging_id">
                                                (<span t-field="line.product_packaging_qty" t-options="{&quot;widget&quot;: &quot;integer&quot;}"/> <span t-field="line.product_packaging_id"/>)
                                            </span>
                                        </td>
                                        <td name="td_priceunit" class="text-end">
                                            <span t-field="line.price_unit">3</span>
                                        </td>
                                        <td t-if="display_discount" class="text-end">
                                            <span t-field="line.discount">-</span>
                                        </td>
                                        <!--     <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>-->
                                        <t t-if="language == 'fr_CA'">
                                            <t t-set="taxes"
                                                t-value="', '.join([(tax.invoice_label or tax.name).replace('GST', 'TPS').replace('HST', 'TVH').replace('QST', 'TVQ') for tax in line.tax_ids])"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="taxes"
                                                   t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                            </t>
                                            <td name="td_taxes"
                                                t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <span t-out="taxes">Tax 15%</span>
                                            </td>
                                            <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                                <t t-if="language == 'en_CA' or language == 'en_US'" t-set="line_price" t-value="'$ {value:,.2f}'.format(value= line.price_subtotal)" />
                                                <t t-elif="language == 'fr_CA' or language == 'es_ES'" t-set="line_price" t-value="'{value:,.2f} $'.format(value= line.price_subtotal)" />
                                                <span t-out="line_price" />
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td t-if="line.name  == '$block+'" name="td_section_line" colspan="99">
                                                <span></span>
                                            </td>
                                            <td t-elif="(line.name == '$rental_info') or (line.name == '#rental_info')" name="td_section_line" colspan="99" style="border-color: #fff !important; border-top-color: #000 !important">
                                                <t t-if="language == 'en_CA' or language == 'en_US'">
                                                    <p t-out="'Start of the Rental: Due to an upgrade in our rental system this is deprecated and no longer visible.'" />
                                                    <p t-out="'End of the Rental: Due to an upgrade in our rental system this is deprecated and no longer visible.'" />
                                                </t>
                                                <t t-elif="language == 'fr_CA'">
                                                    <p t-out="&quot;Début de la Location: Suite à une mise à jour de notre système de location, cette fonctionnalité est désuète et n'est plus visible.&quot;"/>
                                                    <p t-out="&quot;Fin estimée de la Location: Suite à une mise à jour de notre système de location, cette fonctionnalité est désuète et n'est plus visible.&quot;"/>
                                                </t>
                                                <t t-elif="language == 'es_ES'">
                                                    <p t-out="'Inicio del alquiler: Suite a una actualización de nuestro sistema de alquiler, esta funcionalidad está obsoleta y ya no es visible.'" />
                                                    <p t-out="'Fin del alquiler: Suite a una actualización de nuestro sistema de alquiler, esta funcionalidad está obsoleta y ya no es visible.'" />
                                                </t>
                                                <p class="rental_price_explain" t-if="language == 'en_CA' or language == 'en_US'">
                                                    * The final rental cost will be calculated once the equipement is returned.
                                                    Weekly rental cost is equivalent to 4x the indicated daily rental rate (above).
                                                    Monthly (30 days) rental cost is equivalent to 12x the indicated daily rental rate (above).
                                                </p>
                                                <p class="rental_price_explain" t-elif="language == 'fr_CA'">
                                                    * Le coût final sera calculé lorsque l'équipement sera retourné.
                                                    Le taux de location à la semaine est équivalent à 4x le taux journalier ci-haut.
                                                    Le taux de location au mois (30 jours) est équivalent à 12x le taux journalier ci-haut.
                                                </p>
                                                <p class="rental_price_explain" t-elif="language == 'es_ES'">
                                                    * El costo final del alquiler se calculará una vez que se devuelva el equipo.
                                                    El costo de alquiler semanal es equivalente a 4 veces la tarifa diaria indicada (arriba).
                                                    El costo de alquiler mensual (30 días) es equivalente a 12 veces la tarifa diaria indicada (arriba).
                                                </p>
                                                <!-- Format Estimated Rental Rate Number -->
                                                <t t-if="language == 'en_CA' or language == 'en_US'">
                                                    <span class="rental_price_estimate">
                                                        Estimated rental cost of chosen hardware + accessories:
                                                        <span>No longer supported</span>
                                                    </span>
                                                </t>
                                                <t t-elif="language == 'fr_CA'">
                                                    <span class="rental_price_estimate">
                                                        Coût estimé de la location de l'équipement et les accessoires:
                                                        <span>N'est plus pris en charge</span>
                                                    </span>
                                                </t>
                                                <t t-elif="language == 'es_ES'">
                                                    <span class="rental_price_estimate">
                                                        Costo estimado del alquiler del equipo y los accesorios:
                                                        <span>No más soportado</span>
                                                    </span>
                                                </t>
                                                <br />
                                                <br />

                                                <!-- Format Rental Value Number -->
                                                <div class="rental_product_value" t-if="language == 'en_CA' or language == 'en_US'">
                                                    <span>Total Rental Value:&#160; No longer supported</span>
                                                    <br />
                                                    <br />
                                                    <span>
                                                        Please upload your proof of insurance in the comments section below or send a copy by email.
                                                    </span>
                                                    <br />
                                                </div>
                                                <div class="rental_product_value" t-elif="language == 'fr_CA'">
                                                    <span>Valeur locative totale: &#160;N'est plus pris en charge</span>
                                                    <br />
                                                    <br />
                                                    <span>
                                                        Merci de fournir votre attestation d'assurance :
                                                    </span>
                                                    <br />
                                                </div>
                                                <div class="rental_product_value" t-elif="language == 'es_ES'">
                                                    <span>Valor total del alquiler:&#160; No más soportado</span>
                                                    <br />
                                                    <br />
                                                    <span>
                                                        Por favor, cargue su comprobante de seguro en la sección de comentarios a continuación o envíe una copia por correo electrónico.
                                                    </span>
                                                    <br />
                                                </div>
                                            </td>
                                            <td t-elif="line.name  == '#rental_software'" name="td_section_line" colspan="99">
                                                <span t-if="language == 'fr_CA'">Location de logiciels: choisissez les logiciels souhaités ainsi que les quantités (en semaines)</span>
                                                <span t-elif="language == 'es_ES'">Alquiler de software: elija el software deseado junto con las cantidades (en semanas)</span>
                                                <span t-else="">Software rental: choose desired software along with quantities (in weeks)</span>
                                            </td>
                                            <td t-elif="line.name == '#rental_accessories'" name="td_section_line" colspan="99">
                                                <span t-if="language == 'fr_CA'">Accessoires de Location</span>
                                                <span t-elif="language == 'es_ES'">Accesorios de alquiler</span>
                                                <span t-else="">Rental Accessories</span>
                                            </td>
                                            <td t-elif="line.name  == '$subscription'" name="td_section_line" colspan="99">
                                                <span t-if="language == 'fr_CA'">Abonnement</span>
                                                <span t-elif="language == 'es_ES'">Suscripción</span>
                                                <span t-else="">Subscription</span>
                                            </td>
                                            <td t-elif="line.name  == '$hardware'" name="td_section_line" colspan="99">
                                                <span t-if="language == 'fr_CA'">Matériel</span>
                                                <span t-elif="language == 'es_ES'">Hardware</span>
                                                <span t-else="">Hardware</span>
                                            </td>
                                            <td t-elif="line.name  == '$software'" name="td_section_line"  colspan="99">
                                                <span t-if="language == 'fr_CA'">Logiciel</span>
                                                <span t-elif="language == 'es_ES'">Software</span>
                                                <span t-else="">Software</span>
                                            </td>
                                            <td t-elif="line.name  == '$block'" name="td_section_line"  colspan="99">
                                                <span></span>
                                            </td>
                                            <td t-elif="'#translate' in line.name" name="td_section_line" colspan="99">
                                                <t t-set="title" t-value="doc.get_translated_term(line.name, language)" />
                                                <span t-esc="title">Translated Title</span>
                                            </td>
                                            <td t-elif="'ccplabel' in line.name" name="td_section_line" colspan="99">
                                                <t t-set="ccp_label" t-value="doc.parse_ccp_label(line.name)" />
                                                <span t-esc="ccp_label">CCP Label</span>
                                            </td>
                                            <td t-else="" name="td_section_line" colspan="99">
                                                <span t-out="line._proquotes_section_name(language)">A section title</span>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <td name="td_note_line" colspan="99">
                                            <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                        </td>
                                    </t>
                                    <t t-else="">

                                    </t>
                                </tr>

                                <t t-if="current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section') and not line.is_downpayment and current_subtotal > 0">
                                    <tr class="is-subtotal text-end">
                                        <td name="td_section_subtotal" colspan="99">
                                            <strong class="mr16">Subtotal</strong>
                                            <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm table-borderless">
                                    <!-- Tax totals -->
                                    <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                    <t t-call="sale.document_tax_totals"/>
                                </table>
                            </div>
                        </div>
                    </div>


                    <!-- custom footer stuff -->
                    <div id="quote_disclaimer">
                        <!-- <t t-if="doc.partner_id.country">
                            <t t-set="currency_label" t-if="language == 'fr_CA' and (doc.partner_id.country == 'Canada' or doc.partner_id.country == 'CA')" t-value="'canadiens'"/>
                            <t t-set="currency_label" t-elif="language == 'fr_CA' and (doc.partner_id.country == 'United States' or doc.partner_id.country == 'US')" t-value="'américains'"/>
                        </t> -->
                        <!-- <t t-set="currency_label" t-if="language == 'fr_CA' and (doc.partner_id.country == 'Canada' or doc.partner_id.country == 'CA')" t-value="'canadiens'"/> -->
                        <t t-set="currency_label" t-value="doc.currency_id.name"/>
                        <br/>
                        <p t-if="language == 'en_CA' or language == 'en_US'">All prices in
                            <t t-out="currency_label"/>
                            dollars. Local sales tax &amp; delivery costs will be added to final invoice (if not already
                            showing). The quote is valid for 30 days after submittal date.
                        </p>
                        <p t-elif="language == 'fr_CA'">Tous les prix sont en dollars <t t-out="currency_label"/>. Les taxes de
                            vente locale et les frais de livraison seront ajoutés à la facture finale (s'ils ne sont pas déjà
                            affichés). Cette soumission est valide pour 30 jours après la date soumise.
                        </p>
                        <p t-elif="language == 'es_ES'">Todos los precios en dólares <t t-out="currency_label"/>. Los impuestos sobre
                            las ventas locales y los costos de entrega se agregarán a la factura final (si no se muestran
                            ya). La cotización es válida por 30 días después de la fecha de presentación.
                        </p>
                        <t t-set="company_name" t-value="doc.company_id.name"/>

                        <t t-if="doc.is_rental_order == True">
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <h1 t-if="language == 'fr_CA'">Termes et conditions</h1>
                            <h1 t-elif="language == 'es_ES'">Términos y condiciones</h1>
                            <h1 t-else="">Terms and Conditions</h1>
                            <!-- Odoo 19 requires t-call on a <t> element (no longer
                                 allowed directly on a <div>); keep the #rentalTerms
                                 wrapper for styling and nest the call inside it. -->
                            <div id="rentalTerms">
                                <t t-call="proquotes.rental_terms"/>
                            </div>
                        </t>

                        <t t-if="'abtech' in doc.company_id.name.lower()">
                            <br/>
                            <br/>
                            <t t-if="language == 'en_CA' or language == 'en_US'">
                                <span class="white-text">R-E-A-L.iT works with partners for fulfillment of certain products and
                                    therefore some or all of the quoted products may be invoiced and delivered by one of our
                                    partners.
                                </span>
                            </t>
                            <t t-elif="language == 'fr_CA'">
                                <span class="white-text">R-E-A-L.iT travaille avec des partenaires pour la fourniture de
                                    certains produits et par conséquent, certains ou tous les produits cités peuvent être
                                    facturés et livrés par l'un de nos partenaires.
                                </span>
                            </t>
