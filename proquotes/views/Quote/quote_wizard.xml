<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mail_compose_message_form_sale_order" model="ir.ui.view">
            <field name="name">mail.compose.message.form.sale.order</field>
            <field name="model">mail.compose.message</field>
            <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
            <field name="arch" type="xml">

                <!-- filter templates -->
                <field name="template_id" position="attributes">
                    <!-- <attribute name="domain">
                        [('name', 'in', ['General Sales', 'Rental Contract', 'Renewal', 'eCommerce Quote Send'])]
                    </attribute> -->
                    <attribute name="context">
                        {'default_model': model, 'default_body_html': body, 'default_subject': subject}
                    </attribute>
                </field>

            </field>
        </record>
        <record id="view_mail_wizard_invite_inherit_hide_send_mail" model="ir.ui.view">
            <field name="name">mail.wizard.invite.form.inherit.hide.send.mail</field>
            <field name="model">mail.wizard.invite</field>
            <field name="inherit_id" ref="mail.mail_wizard_invite_form"/>
            <field name="arch" type="xml">
                <!-- Remove the option to send invitation email when adding followers to the quote document -->
                <field name="notify" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>