<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_ba_email_subject" model="ir.ui.view">
        <field name="name">crm.lead.form.ba.email.subject</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_priority']" position="after">
                <group name="ba_email_subject_group" string="Email Settings" invisible="type != 'opportunity'">
                    <field name="ba_email_subject"
                           string="Email Subject"
                           placeholder="Enter the email subject for outgoing emails..."
                           required="type == 'opportunity'"/>
                </group>
                <group name="ba_company_group" string="Company Info" invisible="type != 'opportunity'">
                    <field name="ba_company_name" placeholder="e.g. Acme Corp"/>
                    <field name="ba_company_website" placeholder="e.g. https://acme.com" widget="url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
