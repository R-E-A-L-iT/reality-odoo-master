<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Replace Odoo's single "Choose a delivery method" list with a
        per-product delivery section inside the address-step delivery form.
        Each shippable product gets its own carrier selection box. Products
        marked no_shipping=True are skipped. Products that pick the same
        carrier are grouped into one delivery line.
    -->
    <template id="delivery_form_per_product"
              inherit_id="website_sale.delivery_form"
              priority="20">
        <xpath expr="//ul[@id='o_delivery_methods']" position="attributes">
            <attribute name="t-if">delivery_methods and not per_product_delivery_info</attribute>
        </xpath>
        <xpath expr="//ul[@id='o_delivery_methods']" position="before">
            <t t-if="per_product_delivery_info">
                <t t-foreach="per_product_delivery_info" t-as="pdi">
                    <div class="o_per_product_delivery mb-3"
                         t-att-data-line-id="pdi['line'].id">
                        <h4 class="fs-6 small text-uppercase fw-bolder mb-2">
                            Delivery for
                            <t t-esc="pdi['line'].product_id.name"/>
                        </h4>
                        <!-- Not "card": website_sale's Checkout interaction binds a
                             delegated click handler to '.card' anywhere inside
                             #shop_checkout (for address-selection cards) and reads
                             data-partner-id from the clicked element. This box only
                             carries data-line-id, so a literal .card class here makes
                             clicking a carrier radio also fire that handler with an
                             undefined partner id, crashing /shop/update_address. -->
                        <div class="o_per_product_delivery_box bg-white rounded">
                            <ul class="list-group list-group-flush">
                                <t t-foreach="pdi['carriers']" t-as="delivery">
                                    <li class="list-group-item px-0">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="radio"
                                                    t-att-name="'delivery_type_line_%s' % pdi['line'].id"
                                                    t-att-value="delivery.id"
                                                    t-att-data-line-id="pdi['line'].id"
                                                    t-att-data-carrier-id="delivery.id"
                                                    t-att-id="'del_%s_line_%s' % (delivery.id, pdi['line'].id)"
                                                    t-att-checked="pdi['selected_carrier'] and pdi['selected_carrier'].id == delivery.id or None"/>
                                                <label class="mb-0"
                                                       t-att-for="'del_%s_line_%s' % (delivery.id, pdi['line'].id)">
                                                    <t t-esc="delivery.name"/>
                                                </label>
                                            </div>
                                            <span class="o_wsale_delivery_badge_price_line badge text-bg-primary"
                                                  t-att-data-carrier-id="delivery.id"
                                                  t-att-data-line-id="pdi['line'].id">
                                                ...
                                            </span>
                                        </div>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
        <xpath expr="//form[@id='o_delivery_form']" position="before">
            <t t-if="has_non_shippable_products and per_product_delivery_info">
                <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                    <i class="fa fa-info-circle fa-lg flex-shrink-0"/>
                    <span>
                        Shipping applies only to the <strong>physical products</strong>
                        in your order. Digital products are delivered electronically
                        at no shipping cost.
                    </span>
                </div>
            </t>
        </xpath>
    </template>

    <!--
        The base cart total row only shows a computed amount when carrier_id is
        set. We never set order.carrier_id in per-product mode, so key the
        displayed value off amount_delivery instead.
    -->
    <template id="total_delivery_per_product"
              inherit_id="website_sale.total"
              priority="20">
        <xpath expr="//tr[@name='o_order_delivery']//span[@name='o_message_no_dm_set']" position="attributes">
            <attribute name="t-att-class">'d-none' if (website_sale_order.carrier_id or website_sale_order.amount_delivery) else ''</attribute>
        </xpath>
        <xpath expr="//tr[@name='o_order_delivery']//span[@name='o_message_no_dm_set']/following-sibling::span" position="attributes">
            <attribute name="t-att-class">'monetary_field' + ('' if (website_sale_order.carrier_id or website_sale_order.amount_delivery) else ' d-none')</attribute>
        </xpath>
    </template>

</odoo>
