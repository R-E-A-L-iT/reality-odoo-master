<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="quote_address_selector"
              name="Quote Address Selector"
              inherit_id="proquotes.sale_order_portal_content"
              priority="18">

        <xpath expr="//div[@id='rental-address-section']" position="replace">

            <!-- ===== ADDRESS SELECTOR SECTION ===== -->
            <div id="rental-address-section">

                <!-- Precompute address lists -->
                <t t-set="invoice_addresses" t-value="sale_order.partner_id.child_ids.filtered(lambda p: p.type == 'invoice' and p.active)"/>
                <t t-set="delivery_addresses" t-value="sale_order.partner_id.child_ids.filtered(lambda p: p.type == 'delivery' and p.active)"/>
                <t t-set="default_partner" t-value="sale_order.partner_id"/>

                <!-- Country / state lists for modal edit form and new address forms -->
                <t t-set="all_countries" t-value="request.env['res.country'].sudo().search([], order='name asc')"/>
                <t t-set="all_states"    t-value="request.env['res.country.state'].sudo().search([], order='name asc')"/>

                <!-- ===== INVOICE ADDRESS ===== -->
                <div class="addr_matrix mb-3">
                    <div class="addr_hdr">
                        <h4 t-if="language == 'fr_CA'">Adresse de facturation</h4>
                        <h4 t-elif="language == 'es_ES'">Dirección de facturación</h4>
                        <h4 t-else="">Invoice Address</h4>
                    </div>

                    <div class="addr_cards" id="invoice-address-cards"
                         t-att-data-default-partner-id="default_partner.id"
                         t-att-data-default-name="default_partner.name or ''"
                         t-att-data-default-street="default_partner.street or ''"
                         t-att-data-default-city="default_partner.city or ''"
                         t-att-data-default-state="default_partner.state_id.name or ''"
                         t-att-data-default-zip="default_partner.zip or ''"
                         t-att-data-default-country="default_partner.country_id.name or ''">

                        <!-- Default company address shown when no invoice-typed addresses exist -->
                        <t t-if="not invoice_addresses">
                            <div t-attf-class="addr_card{{ ' current' if sale_order.partner_invoice_id.id == default_partner.id else '' }}"
                                 t-att-data-partner-id="default_partner.id"
                                 data-address-type="invoice"
                                 style="cursor:pointer; padding-top:36px;">

                                <div class="addr_card_actions">
                                    <button class="addr_action_btn addr_edit_btn"
                                            t-att-data-partner-id="default_partner.id"
                                            t-att-data-name="default_partner.name or ''"
                                            t-att-data-street="default_partner.street or ''"
                                            t-att-data-city="default_partner.city or ''"
                                            t-att-data-zip="default_partner.zip or ''"
                                            t-att-data-state-id="default_partner.state_id.id or 0"
                                            t-att-data-country-id="default_partner.country_id.id or 0"
                                            data-address-type="invoice"
                                            title="Edit">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button class="addr_action_btn addr_delete_btn"
                                            t-att-data-partner-id="default_partner.id"
                                            data-address-type="invoice"
                                            title="Delete">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>

                                <span class="addr_badge mb-1">Default</span>
                                <div class="name" t-esc="default_partner.name"/>
                                <div class="lines">
                                    <t t-if="default_partner.street"><t t-esc="default_partner.street"/><br/></t>
                                    <t t-if="default_partner.city or default_partner.state_id or default_partner.zip">
                                        <t t-if="default_partner.city"><t t-esc="default_partner.city"/><t t-if="default_partner.state_id or default_partner.zip">, </t></t>
                                        <t t-if="default_partner.state_id"><t t-esc="default_partner.state_id.name"/> </t>
                                        <t t-if="default_partner.zip"><t t-esc="default_partner.zip"/></t>
                                        <br/>
                                    </t>
                                    <t t-if="default_partner.country_id"><t t-esc="default_partner.country_id.name"/></t>
                                </div>
                            </div>
                        </t>

                        <!-- Existing invoice address cards -->
                        <t t-foreach="invoice_addresses" t-as="addr">
                            <div t-attf-class="addr_card{{ ' current' if addr.id == sale_order.partner_invoice_id.id else '' }}"
                                 t-att-data-partner-id="addr.id"
                                 data-address-type="invoice"
                                 style="cursor:pointer; padding-top:36px;">

                                <div class="addr_card_actions">
                                    <button class="addr_action_btn addr_edit_btn"
                                            t-att-data-partner-id="addr.id"
                                            t-att-data-name="addr.name or ''"
                                            t-att-data-street="addr.street or ''"
                                            t-att-data-city="addr.city or ''"
                                            t-att-data-zip="addr.zip or ''"
                                            t-att-data-state-id="addr.state_id.id or 0"
                                            t-att-data-country-id="addr.country_id.id or 0"
                                            data-address-type="invoice"
                                            title="Edit">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button class="addr_action_btn addr_delete_btn"
                                            t-att-data-partner-id="addr.id"
                                            data-address-type="invoice"
                                            title="Delete">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>

                                <div class="name" t-esc="addr.name"/>
                                <div class="lines">
                                    <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                                    <t t-if="addr.city or addr.state_id or addr.zip">
                                        <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                                        <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                                        <t t-if="addr.zip"><t t-esc="addr.zip"/></t>
                                        <br/>
                                    </t>
                                    <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                                </div>
                            </div>
                        </t>

                    </div>

                </div>

                <!-- ===== DELIVERY ADDRESS ===== -->
                <div class="addr_matrix">
                    <div class="addr_hdr">
                        <h4 t-if="language == 'fr_CA'">Adresse de livraison</h4>
                        <h4 t-elif="language == 'es_ES'">Dirección de entrega</h4>
                        <h4 t-else="">Delivery Address</h4>
                    </div>

                    <div class="addr_cards" id="delivery-address-cards"
                         t-att-data-default-partner-id="default_partner.id"
                         t-att-data-default-name="default_partner.name or ''"
                         t-att-data-default-street="default_partner.street or ''"
                         t-att-data-default-city="default_partner.city or ''"
                         t-att-data-default-state="default_partner.state_id.name or ''"
                         t-att-data-default-zip="default_partner.zip or ''"
                         t-att-data-default-country="default_partner.country_id.name or ''">

                        <!-- Default company address shown when no delivery-typed addresses exist -->
                        <t t-if="not delivery_addresses">
                            <div t-attf-class="addr_card{{ ' current' if sale_order.partner_shipping_id.id == default_partner.id else '' }}"
                                 t-att-data-partner-id="default_partner.id"
                                 data-address-type="delivery"
                                 style="cursor:pointer; padding-top:36px;">

                                <div class="addr_card_actions">
                                    <button class="addr_action_btn addr_edit_btn"
                                            t-att-data-partner-id="default_partner.id"
                                            t-att-data-name="default_partner.name or ''"
                                            t-att-data-street="default_partner.street or ''"
                                            t-att-data-city="default_partner.city or ''"
                                            t-att-data-zip="default_partner.zip or ''"
                                            t-att-data-state-id="default_partner.state_id.id or 0"
                                            t-att-data-country-id="default_partner.country_id.id or 0"
                                            data-address-type="delivery"
                                            title="Edit">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button class="addr_action_btn addr_delete_btn"
                                            t-att-data-partner-id="default_partner.id"
                                            data-address-type="delivery"
                                            title="Delete">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>

                                <span class="addr_badge mb-1">Default</span>
                                <div class="name" t-esc="default_partner.name"/>
                                <div class="lines">
                                    <t t-if="default_partner.street"><t t-esc="default_partner.street"/><br/></t>
                                    <t t-if="default_partner.city or default_partner.state_id or default_partner.zip">
                                        <t t-if="default_partner.city"><t t-esc="default_partner.city"/><t t-if="default_partner.state_id or default_partner.zip">, </t></t>
                                        <t t-if="default_partner.state_id"><t t-esc="default_partner.state_id.name"/> </t>
                                        <t t-if="default_partner.zip"><t t-esc="default_partner.zip"/></t>
                                        <br/>
                                    </t>
                                    <t t-if="default_partner.country_id"><t t-esc="default_partner.country_id.name"/></t>
                                </div>
                            </div>
                        </t>

                        <!-- Existing delivery address cards -->
                        <t t-foreach="delivery_addresses" t-as="addr">
                            <div t-attf-class="addr_card{{ ' current' if addr.id == sale_order.partner_shipping_id.id else '' }}"
                                 t-att-data-partner-id="addr.id"
                                 data-address-type="delivery"
                                 style="cursor:pointer; padding-top:36px;">

                                <div class="addr_card_actions">
                                    <button class="addr_action_btn addr_edit_btn"
                                            t-att-data-partner-id="addr.id"
                                            t-att-data-name="addr.name or ''"
                                            t-att-data-street="addr.street or ''"
                                            t-att-data-city="addr.city or ''"
                                            t-att-data-zip="addr.zip or ''"
                                            t-att-data-state-id="addr.state_id.id or 0"
                                            t-att-data-country-id="addr.country_id.id or 0"
                                            data-address-type="delivery"
                                            title="Edit">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button class="addr_action_btn addr_delete_btn"
                                            t-att-data-partner-id="addr.id"
                                            data-address-type="delivery"
                                            title="Delete">
                                        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>

                                <div class="name" t-esc="addr.name"/>
                                <div class="lines">
                                    <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                                    <t t-if="addr.city or addr.state_id or addr.zip">
                                        <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                                        <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                                        <t t-if="addr.zip"><t t-esc="addr.zip"/></t>
                                        <br/>
                                    </t>
                                    <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                                </div>
                            </div>
                        </t>

                    </div>

                </div>

                <!-- ===== SHARED EDIT MODAL ===== -->
                <div id="addr-edit-modal" style="display:none;">
                    <div id="addr-edit-modal-backdrop"/>
                    <div id="addr-edit-modal-box">
                        <input type="hidden" id="edit-modal-partner-id"/>
                        <input type="hidden" id="edit-modal-address-type"/>

                        <div class="addr_editor" style="margin:0; border:none; padding:0; background:transparent;">
                            <div class="cols">
                                <fieldset style="min-width:100%; flex:1 1 100%;">
                                    <legend id="edit-modal-legend" t-if="language == 'fr_CA'">Modifier l'adresse</legend>
                                    <legend id="edit-modal-legend" t-elif="language == 'es_ES'">Editar dirección</legend>
                                    <legend id="edit-modal-legend" t-else="">Edit Address</legend>

                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">Nom</label>
                                        <label t-elif="language == 'es_ES'">Nombre</label>
                                        <label t-else="">Name</label>
                                        <input type="text" id="edit-modal-name" placeholder=""/>
                                    </div>
                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">Rue</label>
                                        <label t-elif="language == 'es_ES'">Calle</label>
                                        <label t-else="">Street</label>
                                        <input type="text" id="edit-modal-street" placeholder=""/>
                                    </div>
                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">Ville</label>
                                        <label t-elif="language == 'es_ES'">Ciudad</label>
                                        <label t-else="">City</label>
                                        <input type="text" id="edit-modal-city" placeholder=""/>
                                    </div>
                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">Pays</label>
                                        <label t-elif="language == 'es_ES'">País</label>
                                        <label t-else="">Country</label>
                                        <select id="edit-modal-country" class="form-select form-select-sm">
                                            <option value="">— Select —</option>
                                            <t t-foreach="all_countries" t-as="c">
                                                <option t-att-value="c.id" t-esc="c.name"/>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">État/Province</label>
                                        <label t-elif="language == 'es_ES'">Estado</label>
                                        <label t-else="">State/Province</label>
                                        <select id="edit-modal-state" class="form-select form-select-sm">
                                            <option value="">— Select —</option>
                                            <t t-foreach="all_states" t-as="s">
                                                <option t-att-value="s.id"
                                                        t-att-data-country-id="s.country_id.id"
                                                        t-esc="s.name"/>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="row">
                                        <label t-if="language == 'fr_CA'">Code postal</label>
                                        <label t-elif="language == 'es_ES'">Código postal</label>
                                        <label t-else="">Zip/Postal Code</label>
                                        <input type="text" id="edit-modal-zip" placeholder=""/>
                                    </div>

                                    <div class="actions">
                                        <button type="button" id="save-edit-modal" class="btn btn-primary btn-sm">
                                            <t t-if="language == 'fr_CA'">Enregistrer</t>
                                            <t t-elif="language == 'es_ES'">Guardar</t>
                                            <t t-else="">Save</t>
                                        </button>
                                        <button type="button" id="cancel-edit-modal" class="btn btn-secondary btn-sm ms-2">
                                            <t t-if="language == 'fr_CA'">Annuler</t>
                                            <t t-elif="language == 'es_ES'">Cancelar</t>
                                            <t t-else="">Cancel</t>
                                        </button>
                                    </div>
                                </fieldset>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- ===== END SHARED EDIT MODAL ===== -->

            </div>
            <!-- ===== END ADDRESS SELECTOR SECTION ===== -->

        </xpath>

    </template>

</odoo>
