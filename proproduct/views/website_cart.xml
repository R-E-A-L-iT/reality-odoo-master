<odoo>
    <template id="custom_cart_tax_label" inherit_id="website_sale.total">
        
        <!-- Replace the tax amount cell/element -->
        <xpath expr="//span[@t-out='website_sale_order.amount_tax']" position="replace">
            <t t-if="website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.country_id">
                <span t-out="website_sale_order.amount_tax"
                      t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
            </t>
            <t t-else="">
                <span class="text-muted">Taxes calculated at checkout</span>
            </t>
        </xpath>

    </template>
</odoo>