<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="website_sale_total_cart_only_override"
              inherit_id="website_sale.total">

        <!-- Taxes row -->
        <xpath expr="//tr[@name='o_order_total_taxes']" position="replace">

            <tr name="o_order_total_taxes">

                <!-- CART PAGE -->
                <t t-if="request.httprequest.path == '/shop/cart'">

                    <td colspan="3"
                        class="text-muted border-0 ps-0 pt-0 pb-3">

                        Taxes calculated at checkout

                        <!-- keep hidden span so JS doesn't crash -->
                        <span id="order_total_taxes_amount"
                              style="display:none;"
                              t-field="website_sale_order.amount_tax"
                              class="monetary_field"
                              t-options="{
                                  'widget': 'monetary',
                                  'display_currency': website_sale_order.currency_id
                              }"/>

                    </td>

                </t>

                <!-- ALL OTHER STEPS (checkout / payment) -->
                <t t-else="">

                    <td colspan="2"
                        class="text-muted border-0 ps-0 pt-0 pb-3">
                        Taxes
                    </td>

                    <td class="text-end border-0 pe-0 pt-0 pb-3">

                        <span t-field="website_sale_order.amount_tax"
                              class="monetary_field"
                              t-options="{
                                  'widget': 'monetary',
                                  'display_currency': website_sale_order.currency_id
                              }"/>

                    </td>

                </t>

            </tr>

        </xpath>

        <!-- Total row -->
        <xpath expr="//tr[@name='o_order_total']" position="replace">

            <tr name="o_order_total" class="border-top">

                <!-- CART PAGE -->
                <t t-if="request.httprequest.path == '/shop/cart'">

                    <td colspan="2"
                        class="border-0 ps-0 pt-3">
                        <strong>Total before tax</strong>
                    </td>

                    <td class="text-end border-0 px-0 pt-3">

                        <strong t-field="website_sale_order.amount_untaxed"
                                class="monetary_field text-end p-0"
                                t-options="{
                                    'widget': 'monetary',
                                    'display_currency': website_sale_order.currency_id
                                }"/>

                    </td>

                </t>

                <!-- CHECKOUT / PAYMENT -->
                <t t-else="">

                    <td colspan="2"
                        class="border-0 ps-0 pt-3">
                        <strong>Total</strong>
                    </td>

                    <td class="text-end border-0 px-0 pt-3">

                        <strong t-field="website_sale_order.amount_total"
                                class="monetary_field text-end p-0"
                                t-options="{
                                    'widget': 'monetary',
                                    'display_currency': website_sale_order.currency_id
                                }"/>

                    </td>

                </t>

            </tr>

        </xpath>

    </template>

</odoo>