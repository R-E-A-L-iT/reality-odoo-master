<odoo>
    <record id="view_bundle_receipt_wizard_form" model="ir.ui.view">
        <field name="name">bundle.receipt.wizard.form</field>
        <field name="model">bundle.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Serial Numbers to Bundles">
                <group>
                    <span>Please fill out a serial number for each bundle in the list below to continue.<span/>
                    <field name="serial_lines">
                        <tree editable="bottom">
                            <field name="bundle_name" readonly="1"/>
                            <field name="serial_number"/>
                            <field name="product_names" readonly="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button string="Confirm RFQ" type="object" name="action_confirm_with_serials" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
