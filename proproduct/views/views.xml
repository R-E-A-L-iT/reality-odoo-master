<odoo>
    <record id="view_stock_production_lot_form_inherit_bundle" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.bundle</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="bundle_instance_id"/>
            </xpath>
        </field>
    </record>
</odoo>
