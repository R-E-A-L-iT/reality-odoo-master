<odoo>

    <!-- add bundle id field to stock.lot -->
    <record id="view_stock_production_lot_form_inherit_bundle" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.bundle</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="bundle_instance_id"/>
            </xpath>
        </field>
    </record>

    <!-- add bundle to invoice button -->
    <record id="view_invoice_form_inherit_add_bundle" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bundle</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
            <button name="action_open_bundle_wizard"
                    type="object"
                    string="Add Product Bundle"
                    class="btn-primary"
                    attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </xpath>
        </field>
    </record>

    <!-- invoice add bundle wizard -->
    <record id="action_open_bundle_wizard_invoice" model="ir.actions.act_window">
        <field name="name">Select Product Bundle</field>
        <field name="res_model">product.bundle.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_model': 'account.move', 'default_res_id': active_id}</field>
    </record>

    <!-- add bundle to po/rfq button -->
    <record id="view_purchase_order_form_inherit_add_bundle" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.bundle</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
            <button name="action_open_bundle_wizard"
                    type="object"
                    string="Add Product Bundle"
                    class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- po/rfq add bundle wizard -->
    <record id="action_open_bundle_wizard_purchase" model="ir.actions.act_window">
        <field name="name">Select Product Bundle</field>
        <field name="res_model">product.bundle.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_model': 'purchase.order', 'default_res_id': active_id}</field>
    </record>

</odoo>

