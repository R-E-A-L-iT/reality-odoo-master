<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Odoo 19 rebuild.

        Anchors were re-derived from this database's COMBINED arch
        (ir.ui.view.get_combined_arch()), not from upstream source, because the
        stored views also carry the theme and website-editor customisations.

        Gone in v19, so the old xpaths were dropped:
          * //t[@t-cache]                     - the product page cache wrapper
          * //div[@id='o_product_terms_and_share']
          * //p[@t-field='product.description_sale'] - description_sale is no
            longer rendered inside website_sale.product at all.
        Also dropped deliberately:
          * the t-set='combination_info' price forcing and the MutationObserver
            "price lock". Both existed because the pricelist never resolved
            correctly (models/website.py hooked methods v19 deleted). That is
            fixed at the model level now, so the price should render right the
            first time; re-add a workaround only if it demonstrably does not.
          * the [proproduct] console.log debug block.
    -->

    <!--
        ADD TO CART GATING.

        v19 moved #add_to_cart_wrap out of website_sale.product into its own
        website_sale.cta_wrapper template, so this must inherit cta_wrapper.

        The div now also CONTAINS the quantity selector and carries a
        subscription-plan data attribute, so the old position="replace" would
        quietly delete core functionality. Gate it with an added t-if and add the
        fallback as a sibling instead — core markup is left completely intact.
    -->
    <template id="proproduct_cta_add_to_cart_gate" inherit_id="website_sale.cta_wrapper">

        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <t t-set="proproduct_pricelist" t-value="request.pricelist"/>
            <t t-set="proproduct_currency"
               t-value="proproduct_pricelist and proproduct_pricelist.currency_id.name or ''"/>
            <!-- Is this product published for the region the visitor is shopping in? -->
            <t t-set="proproduct_region_allowed"
               t-value="(proproduct_currency == 'USD' and product.is_us)
                        or (proproduct_currency == 'CAD' and product.is_ca)"/>
            <t t-set="proproduct_can_buy"
               t-value="product.show_add_to_cart and proproduct_region_allowed"/>
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">proproduct_can_buy</attribute>
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <div t-if="not proproduct_can_buy"
                 id="proproduct_contact_wrap"
                 class="d-flex flex-grow-1 flex-lg-grow-0 flex-wrap align-items-center gap-2">
                <t t-set="proproduct_lang" t-value="request.lang.code"/>
                <a role="button" class="btn btn-primary flex-grow-1" href="/contact">
                    <i class="fa fa-envelope me-2"/>
                    <t t-if="proproduct_lang == 'fr_CA'">Contactez-Nous</t>
                    <t t-elif="proproduct_lang == 'es_ES'">Contáctenos</t>
                    <t t-else="">Contact us</t>
                </a>
            </div>
        </xpath>

    </template>

    <!--
        APPROVE FINANCING SECTION.

        Anchored after the cta_wrapper call inside the product details column —
        the closest surviving equivalent to the old o_product_terms_and_share
        position. USD-only, as before.
    -->
    <template id="proproduct_product_approve_financing" inherit_id="website_sale.product">

        <xpath expr="//t[@t-call='website_sale.cta_wrapper']" position="after">
            <t t-set="proproduct_pricelist" t-value="request.pricelist"/>
            <section class="approve_section"
                     t-if="product.approve_financing
                           and proproduct_pricelist
                           and proproduct_pricelist.currency_id.name == 'USD'">
                <div class="approve_section_inner">

                    <style>
                        .approve_section {
                            padding: 7px;
                            background-color: #db0d0d;
                            border-radius: 35px;
                            box-shadow: 0 0 25px 5px rgba(255, 0, 0, 0.5);
                            margin-bottom: 10px;
                            transition: transform 0.3s ease;
                        }
                        .approve_section_inner {
                            padding: 18px;
                            border: 1px solid #fff;
                            border-radius: 28px;
                        }
                        .approve_section_header {
                            width: 100%;
                            height: auto;
                            display: flex;
                            justify-content: center;
                        }
                        .approve_section_header > img { width: 40%; height: auto; }
                        .approve_section:hover { transform: scale(1.01); }
                        .approve_teaser_block { text-align: center; color: white; margin: 25px 0; }
                        .approve_teaser_header { font-size: 1.3rem; font-weight: 600; margin-bottom: 10px; }
                        .approve_teaser_price { font-size: 4rem; font-weight: 700; }
                        .approve_teaser_suffix { font-size: 2rem; font-weight: 600; margin-left: 5px; }
                        .approve_teaser_subtext { font-size: 0.9rem; margin-top: 5px; color: #eee; }
                        .approve_teaser_pitch { font-size: 1rem; font-weight: 500; margin-top: 20px; line-height: 1.4; }
                        .approve_learn_more { color: white; text-decoration: underline; font-weight: 600; }
                        .approve_button_section { display: flex; justify-content: center; align-items: center; }
                        .flash-button {
                            position: relative;
                            overflow: hidden;
                            box-shadow: 0 0 25px 5px rgba(255, 208, 208, 0.5);
                            -webkit-appearance: none;
                            border-radius: 12px;
                            background-color: #fff;
                            color: #000;
                            font-weight: bold;
                            font-family: "Fira Sans", sans-serif;
                            width: 200px;
                            height: 50px;
                            cursor: pointer;
                            transition: transform 0.3s ease;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                        }
                        .flash-button:focus {
                            outline: none;
                            box-shadow: 0 0 25px 5px rgba(255, 208, 208, 0.5);
                        }
                        .flash-button span {
                            position: relative;
                            z-index: 1;
                            text-transform: uppercase;
                            font-size: 16px;
                        }
                        .flash-button::after {
                            content: '';
                            position: absolute;
                            top: -75%;
                            left: -100%;
                            width: 40%;
                            height: 250%;
                            background: rgba(255, 162, 162, 0.3);
                            transform: rotate(25deg);
                            pointer-events: none;
                            z-index: 0;
                            transition: left 0.6s ease;
                        }
                        .flash-button:hover::after { left: 120%; }
                    </style>

                    <script type="text/javascript" async=""> window.kwipped_approve = window.kwipped_approve || {}; window.kwipped_approve.url = "https://www.kwipped.com"; window.kwipped_approve.approve_id = "eyJpdiI6Ik5US0IxcDN5dnFNcW16amZXN28weWc9PSIsInZhbHVlIjoidGYxRzl2eml4MkNkTHIwbkE1OGdLZz09IiwibWFjIjoiZDVkMzEzODUzOTNmOTg0MTlmOWFmMmI3ZjRhODA2YjBmNzFiMzBhZGMwNTE0MjMwYTMwNzlmYjYzYWMwMGUyNiJ9"; function init_kwipped_approve_snippet() { var b = document.getElementsByTagName('body')[0]; var t = document.querySelector('approve-widget'); if (!t) { t = document.createElement('approve-widget'); t.setAttribute('autosubmission', 1); t.setAttribute('theme', 'custom'); t.setAttribute('themestyle', '{"bgcolor":"#DB0E0D","header_font":{"fontFamily":"","fontWeight":"","fontStyle":""},"inner_bgcolor":"#FFFFFF","button_bgcolor":"#DC0D0F","button_border_color":"#ebebeb","button_text_color":"#FFFFFF","button_font":{"fontFamily":"","fontWeight":"","fontStyle":""},"maintext_font":{"fontFamily":"","fontWeight":"","fontStyle":""},"maintext_color":"#000000","headertext_color":"#FFFFFF"}'); b.appendChild(t); } var s=document.createElement('script'); s.type= 'text/javascript'; s.src = 'https://api.kwipped.com/approve/plugin/3.0/approve_plugin_loader.php'; b.appendChild(s); } if(document.readyState != 'loading'){ init_kwipped_approve_snippet(); } else{ window.addEventListener('DOMContentLoaded',init_kwipped_approve_snippet); } </script>
                    <span style="display:none;" id="approve_total_var" t-out="product.list_price"/>

                    <div class="approve_section_header">
                        <img src="https://www.approvepayments.com/hubfs/approve_logo_white.png" alt="KWIPPED APPROVE Logo"/>
                    </div>

                    <div class="approve_teaser_block">
                        <div class="approve_teaser_header">Finance as low as</div>
                        <div class="approve_teaser_price">
                            $<span id="approve_teaser_rate" approve-function="teaser_rate" t-att-approve-total="product.list_price"></span>
                            <span class="approve_teaser_suffix">/mo</span>
                        </div>
                        <div class="approve_teaser_subtext">*60 months</div>
                        <div class="approve_teaser_pitch">
                            Multiple Lenders. Competing Offers. <br/>
                            Smart Equipment Financing!
                        </div>
                    </div>

                    <div class="approve_button_section">
                        <button class="flash-button"
                                type="button"
                                approve-function="embedded_app"
                                approve-action="add_to_app"
                                t-att-approve-model="product.name"
                                approve-qty="1"
                                t-att-approve-price="product.list_price"
                                approve-item-type="new_product"
                                style="display: none">
                            <span>INQUIRE NOW</span>
                        </button>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const approveBtn = document.querySelector('.flash-button');
                            if (approveBtn) {
                                approveBtn.addEventListener('click', function () {
                                    if (window.kwipped_approve?.embedded_app?.app_reference?.clear_items) {
                                        window.kwipped_approve.embedded_app.app_reference.clear_items();
                                    }
                                });
                            }
                        });
                    </script>
                </div>
            </section>
        </xpath>

    </template>

</odoo>
