<odoo>

  <!-- Tree View -->
  <record id="view_product_bundle_instance_tree" model="ir.ui.view">
    <field name="name">product.bundle.instance.tree</field>
    <field name="model">product.bundle.instance</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="bundle_id"/>
        <field name="product_qty"/>
        <field name="expire"/>
        <field name="company_id"/>
      </tree>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_product_bundle_instance_form" model="ir.ui.view">
    <field name="name">product.bundle.instance.form</field>
    <field name="model">product.bundle.instance</field>
    <field name="arch" type="xml">
      <form string="Bundle Lot/Serial">
        <sheet>
          <group>
            <field name="name"/>
            <field name="bundle_id"/>
            <field name="sku"/>
            <field name="ref"/>
            <field name="product_qty"/>
            <field name="expire"/>
            <field name="owner"/>
            <field name="company_id"/>
            
            <field name="lot_lines" string="Subproducts">
                <tree>
                    <field name="product_id"/>
                    <field name="name" string="Serial Number"/>
                    <field name="product_qty"/>
                    <field name="expiration_date"/>
                </tree>
            </field>

          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_product_bundle_instance" model="ir.actions.act_window">
    <field name="name">Bundle Lot/Serial</field>
    <field name="res_model">product.bundle.instance</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_product_bundle_instance"
            name="Bundle Lot/Serial"
            parent="stock.menu_stock_inventory_control"
            action="action_product_bundle_instance"
            sequence="30"/>
</odoo>
