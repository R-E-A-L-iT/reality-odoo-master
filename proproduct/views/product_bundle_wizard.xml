<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_bundle_wizard_form" model="ir.ui.view">
        <field name="name">product.bundle.wizard.form</field>
        <field name="model">product.bundle.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Product Bundle to Quote">
                <group>
                    <field name="bundle_id" context="{}"/>
                </group>
                <footer>
                    <button string="Add Bundle to Quote" type="object" name="action_add_bundle_to_quote" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_bundle_wizard" model="ir.actions.act_window">
        <field name="name">Select Product Bundle</field>
        <field name="res_model">product.bundle.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="proproduct.view_product_bundle_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
