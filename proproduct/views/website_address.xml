<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Restrict checkout country list based on pricelist currency,
             but fall back to all countries if no pricelist/currency -->
        <template id="proproduct_website_sale_address_country_restrict"
                  inherit_id="website_sale.address">

            <xpath expr="//select[@id='country_id']/t[@t-foreach='countries']" position="replace">

                <!-- Precompute currency name safely -->
                <t t-set="pl_currency"
                   t-value="website_sale_order.pricelist_id.currency_id.name
                            if website_sale_order.pricelist_id and website_sale_order.pricelist_id.currency_id
                            else None"/>

                <t t-foreach="countries" t-as="c">
                    <t t-if="(pl_currency == 'USD' and c.code == 'US')
                              or
                             (pl_currency == 'CAD' and c.code == 'CA')
                              or
                             (not pl_currency)">
                        <option t-att-value="c.id"
                                t-att-selected="c.id == (country and country.id or -1)">
                            <t t-esc="c.name"/>
                        </option>
                    </t>
                </t>
            </xpath>

        </template>

    </data>
</odoo>
