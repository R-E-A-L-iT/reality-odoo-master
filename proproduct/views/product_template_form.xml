<?xml version="1.0"?>
<odoo>
   <record id="proproduct_product_view" model="ir.ui.view">
       <field name="name">product.template.common.form.view</field>
       <field name="model">product.template</field>
       <field name="priority">3</field>
       <field name="inherit_id" ref="product.product_template_only_form_view" />
       <field name="arch" type="xml">
           <xpath expr="//field[@name='website_id']" position="after">
               <field name="approve_financing" string="APPROVE Financing"/>
           </xpath>
       </field>
   </record>
</odoo>