<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Inactive by default. Staging databases are neutralized (crons disabled):
         activate it manually once the configuration is verified. It still does
         nothing while "Auto sync" is off. -->
    <record id="ir_cron_upgrade_sync" model="ir.cron">
        <field name="name">Upgrade Sync: fetch and replay Odoo 17 events</field>
        <field name="model_id" ref="model_upgrade_sync_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
