<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upgrade_sync_event_view_list" model="ir.ui.view">
        <field name="name">upgrade.sync.event.list</field>
        <field name="model">upgrade.sync.event</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-warning="state == 'waiting'"
                  decoration-success="state in ('success', 'dry_run_ok')" decoration-muted="state == 'skipped'">
                <field name="source_sequence"/>
                <field name="source_date"/>
                <field name="source_user_login"/>
                <field name="event_type"/>
                <field name="source_model"/>
                <field name="source_res_name"/>
                <field name="target_display"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="comparison_result" widget="badge"
                       decoration-success="comparison_result == 'match'"
                       decoration-danger="comparison_result == 'mismatch'"/>
                <field name="error_message" optional="show"/>
                <field name="event_uuid" optional="hide"/>
                <button name="action_process_now" type="object" string="Process" icon="fa-play"
                        invisible="state in ('success', 'skipped', 'dry_run_ok', 'processing')"/>
            </list>
        </field>
    </record>

    <record id="upgrade_sync_event_view_form" model="ir.ui.view">
        <field name="name">upgrade.sync.event.form</field>
        <field name="model">upgrade.sync.event</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_process_now" type="object" string="Process Now" class="oe_highlight"
                            invisible="state in ('success', 'skipped', 'dry_run_ok', 'processing')"/>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state not in ('failed', 'waiting', 'skipped')"/>
                    <button name="action_replay" type="object" string="Replay Again"
                            invisible="state not in ('success', 'dry_run_ok')"
                            confirm="Replay this event again on Odoo 19?"/>
                    <button name="action_skip" type="object" string="Skip"
                            invisible="state in ('success', 'skipped')"/>
                    <button name="action_open_target" type="object" string="Open Odoo 19 Record"
                            invisible="not target_res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,success,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="event_type"/></h1>
                        <field name="event_uuid"/>
                    </div>
                    <group>
                        <group string="Odoo 17">
                            <field name="source_sequence"/>
                            <field name="source_date"/>
                            <field name="source_user_login"/>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="source_res_name"/>
                            <field name="root_key"/>
                        </group>
                        <group string="Odoo 19">
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="target_display"/>
                            <field name="attempt_count"/>
                            <field name="last_attempt"/>
                            <field name="next_retry"/>
                            <field name="processed_at"/>
                            <field name="comparison_result"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_kind"/>
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Comparison" name="comparison">
                            <field name="comparison_html"/>
                        </page>
                        <page string="Payload" name="payload">
                            <field name="payload" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upgrade_sync_event_view_search" model="ir.ui.view">
        <field name="name">upgrade.sync.event.search</field>
        <field name="model">upgrade.sync.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_res_name"/>
                <field name="event_uuid"/>
                <field name="event_type"/>
                <field name="source_model"/>
                <field name="source_user_login"/>
                <field name="root_key"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('pending', 'waiting'))]"/>
                <filter name="success" string="Success" domain="[('state', 'in', ('success', 'dry_run_ok'))]"/>
                <filter name="mismatch" string="Mismatch" domain="[('comparison_result', '=', 'mismatch')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('source_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'source_model'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'source_user_login'}"/>
                    <filter name="group_error" string="Error Kind" context="{'group_by': 'error_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="upgrade_sync_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">upgrade.sync.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="upgrade_sync_event_view_search"/>
    </record>

    <record id="upgrade_sync_event_action_failed" model="ir.actions.act_window">
        <field name="name">Failed Events</field>
        <field name="res_model">upgrade.sync.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_failed': 1}</field>
    </record>

    <record id="upgrade_sync_event_action_waiting" model="ir.actions.act_window">
        <field name="name">Pending / Waiting Events</field>
        <field name="res_model">upgrade.sync.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="upgrade_sync_event_action_retry" model="ir.actions.server">
        <field name="name">Retry</field>
        <field name="model_id" ref="model_upgrade_sync_event"/>
        <field name="binding_model_id" ref="model_upgrade_sync_event"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">records.action_retry()</field>
    </record>

    <record id="upgrade_sync_event_action_process" model="ir.actions.server">
        <field name="name">Process Now</field>
        <field name="model_id" ref="model_upgrade_sync_event"/>
        <field name="binding_model_id" ref="model_upgrade_sync_event"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">records.action_process_now()</field>
    </record>
</odoo>
