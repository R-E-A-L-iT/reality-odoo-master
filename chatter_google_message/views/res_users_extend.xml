<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_users_view_formm_inherit" model="ir.ui.view">
        <field name="name">res.user.form.inherit.mail.email</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//field[@name='signature']" position="after">
                <field name="ba_mass_signature"/>
            </xpath>
            <xpath expr="//page[@name='preferences_page']//field[@name='signature']" position="after">
                <field name="ba_mass_signature"/>
            </xpath>
        </field>
    </record>
</odoo>
