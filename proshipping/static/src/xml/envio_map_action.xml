<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="proshipping.EnvioMapAction">
        <div class="o_envio_map_action" style="height: 100%; display: flex; flex-direction: column;">
            <div class="o_envio_map_header" style="padding: 12px 16px;">
                <h2 style="margin: 0;">Envio Devices Map</h2>
                <t t-if="state.loading">
                    <div class="text-muted">Loading map…</div>
                </t>
                <t t-if="state.error">
                    <div class="text-danger">Error: <t t-esc="state.error"/></div>
                </t>
                <t t-if="!state.loading and !state.error">
                    <div class="text-muted">
                        Showing <t t-esc="state.count"/> device(s) with a location.
                    </div>
                </t>
            </div>

            <div t-ref="mapContainer" style="flex: 1; min-height: 520px; border-top: 1px solid #ddd;"></div>
        </div>
    </t>
</templates>
