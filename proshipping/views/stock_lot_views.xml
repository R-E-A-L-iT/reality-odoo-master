<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_envio" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.envio</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Put it near the lot name/serial -->
            <xpath expr="//group" position="inside">
                <field name="envio_package_id"/>
            </xpath>
        </field>
    </record>
</odoo>
