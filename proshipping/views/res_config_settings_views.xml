<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_envio_connector" model="ir.ui.view">
        <field name="name">res.config.settings.envio.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Put it under the existing General Settings app -->
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Envio IoT" name="envio_iot_settings_block">
                    <setting string="Envio API" help="Configure Envio API connection parameters.">
                        <div class="content-group">
                            <div class="row mt16">
                                <div class="col-12 col-lg-6">
                                    <label for="envio_base_url" class="o_light_label"/>
                                    <field name="envio_base_url" placeholder="https://iot.envio.io"/>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label for="envio_api_token" class="o_light_label"/>
                                    <field name="envio_api_token" password="True"/>
                                </div>
                                <div class="col-12 col-lg-6 mt16">
                                    <label for="envio_header_mode" class="o_light_label"/>
                                    <field name="envio_header_mode"/>
                                </div>

                                <!-- optional if you added this config param -->
                                <div class="col-12 col-lg-6 mt16">
                                    <label for="envio_devices_path" class="o_light_label"/>
                                    <field name="envio_devices_path" placeholder="/api/v1/devices"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
