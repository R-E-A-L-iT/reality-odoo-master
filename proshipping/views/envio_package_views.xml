<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree -->
    <record id="view_envio_package_tree" model="ir.ui.view">
        <field name="name">envio.package.tree</field>
        <field name="model">envio.package</field>
        <field name="arch" type="xml">
            <tree string="Envio Packages">
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="status"/>
                <field name="last_event_at"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="device_id"/>
                <field name="battery_percent"/>
                <field name="temperature_c"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_envio_package_form" model="ir.ui.view">
        <field name="name">envio.package.form</field>
        <field name="model">envio.package</field>
        <field name="arch" type="xml">
            <form string="Envio Device">
                <header>
                    <!-- Keep manual push button as a fallback -->
                    <button name="action_push_envio_update"
                            type="object"
                            string="Push Update to Envio (manual)"
                            class="btn-primary"/>

                    <!-- Optional: keep sync button if you already have it -->
                    <button name="action_sync_envio_packages"
                            type="object"
                            string="Sync Now"
                            class="btn-secondary"/>
                </header>

                <sheet>

                    <!-- Top summary (Envio-like) -->
                    <group>
                        <group string="Device">
                            <field name="envio_external_id" string="ID" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="lot_id"/>
                        </group>

                        <group string="Live">
                            <field name="battery_percent" readonly="1"/>
                            <field name="last_event_at" string="Last Connected" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- General tab -->
                        <page string="General">
                            <group>
                                <group>
                                    <field name="update_frequency_option"/>
                                    <!-- Keep the raw seconds field hidden (still stored + used for payload) -->
                                    <field name="update_frequency_seconds" invisible="1"/>
                                </group>
                                <group>
                                    <field name="inspection_date" string="Equipment Next Inspection"/>
                                </group>
                            </group>
                        </page>

                        <!-- Label tab -->
                        <page string="Label">
                            <group>
                                <group>
                                    <field name="label_image" filename="label_image_filename"/>
                                    <field name="label_image_filename" invisible="1"/>
                                </group>
                                <group>
                                    <!-- If you have any other label fields, put them here -->
                                </group>
                            </group>
                        </page>

                        <!-- Items tab (blank for now) -->
                        <page string="Items">
                            <div class="text-muted">
                                Items will be added here later.
                            </div>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_envio_packages" model="ir.actions.act_window">
        <field name="name">Envio Packages</field>
        <field name="res_model">envio.package</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Envio packages yet.
            </p>
            <p>
                Configure your Envio API credentials in Settings, then click "Sync Now".
            </p>
        </field>
    </record>
</odoo>
