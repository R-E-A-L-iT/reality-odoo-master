<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_quo_send_text_wizard_form" model="ir.ui.view">
        <field name="name">quo.send.text.wizard.form</field>
        <field name="model">quo.send.text.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Text" create="false" edit="false">
                <group>
                    <field name="partner_id"/>
                    <field name="to_number"/>
                    <field name="from_number" required="1"/>
                </group>

                <group>
                    <field name="message" placeholder="Write your message..." nolabel="1"/>
                </group>

                <footer>
                    <button string="Send" type="object" name="action_send" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>