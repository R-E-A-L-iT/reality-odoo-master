<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- CALLS -->
    <record id="view_quo_call_tree" model="ir.ui.view">
        <field name="name">quo.call.tree</field>
        <field name="model">quo.call</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="quo_call_id"/>
                <field name="direction"/>
                <field name="phone_number_id"/>
                <field name="started_at"/>
                <field name="duration_seconds"/>
            </tree>
        </field>
    </record>

    <record id="view_quo_call_form" model="ir.ui.view">
        <field name="name">quo.call.form</field>
        <field name="model">quo.call</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                        <div class="o_row mt-1">
                            <span class="text-muted me-2">Between</span>
                            <field name="caller_from_partner_id" options="{'no_create': False}" class="oe_inline"/>
                            <span class="text-muted mx-2">and</span>
                            <field name="caller_to_partner_id" options="{'no_create': False}" class="oe_inline"/>
                        </div>
                    </div>

                    <br></br>
                    <group string="Call details" colspan="2">
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="direction" readonly="1"/>
                        </group>

                        <!-- Dev-only -->

                    </group>

                    <notebook>
                        <page string="Transcript">
                            <field name="transcript_id" context="{'default_call_id': active_id}">
                                <tree>
                                    <field name="created_at"/>
                                    <field name="status"/>
                                    <field name="duration_seconds"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Summary">
                            <div class="o_form_sheet">
                                <field name="summary_text"
                                    nolabel="1"
                                    placeholder="No summary yet..."
                                    class="oe_full_width"/>

                                <separator string="Next Steps"/>

                                <field name="next_steps_text"
                                    nolabel="1"
                                    placeholder="No next steps yet..."
                                    class="oe_full_width"/>
                            </div>

                        </page>
                        <page string="Recording">
                            <group>
                                <field name="recording_url" widget="url"/>

                            </group>

                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quo_calls" model="ir.actions.act_window">
        <field name="name">Quo Calls</field>
        <field name="res_model">quo.call</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TRANSCRIPTS -->
    <record id="view_quo_transcript_tree" model="ir.ui.view">
        <field name="name">quo.call.transcript.tree</field>
        <field name="model">quo.call.transcript</field>
        <field name="arch" type="xml">
            <tree>
                <field name="quo_call_id"/>
                <field name="created_at"/>
                <field name="status"/>
                <field name="duration_seconds"/>
            </tree>
        </field>
    </record>

    <record id="view_quo_transcript_form" model="ir.ui.view">
        <field name="name">quo.call.transcript.form</field>
        <field name="model">quo.call.transcript</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="call_id" readonly="1"/>
                        <field name="created_at" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="duration_seconds" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Dialogue">
                            <field name="line_ids">
                                <tree editable="false">
                                    <field name="partner_id"/>
                                    <field name="speaker_label" string="Phone #"/>
                                    <field name="start_ms"/>
                                    <field name="end_ms"/>
                                    <field name="content"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quo_transcripts" model="ir.actions.act_window">
        <field name="name">Quo Transcripts</field>
        <field name="res_model">quo.call.transcript</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TEXTS -->
    <record id="view_quo_text_tree" model="ir.ui.view">
        <field name="name">quo.text.tree</field>
        <field name="model">quo.text</field>
        <field name="arch" type="xml">
            <tree>
                <field name="created_at"/>
                <field name="direction"/>
                <field name="from_partner_id"/>
                <field name="to_partner_id"/>
                <field name="body"/>
            </tree>
        </field>
    </record>

    <record id="view_quo_text_form" model="ir.ui.view">
        <field name="name">quo.text.form</field>
        <field name="model">quo.text</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                        <div class="o_row mt-1">
                            <span class="text-muted me-2">Between</span>
                            <field name="from_partner_id" options="{'no_create': False}" class="oe_inline"/>
                            <span class="text-muted mx-2">and</span>
                            <field name="to_partner_id" options="{'no_create': False}" class="oe_inline"/>
                        </div>
                    </div>

                    <group string="Text details">
                        <group>
                            <field name="created_at"/>
                            <field name="direction"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="phone_number_id" groups="base.group_system"/>
                            <field name="conversation_id" groups="base.group_system"/>
                            <field name="quo_message_id" groups="base.group_system"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Message">
                            <field name="body" nolabel="1" class="oe_full_width"/>
                            <separator string="Media"/>
                            <field name="media_json" nolabel="1" widget="text" class="oe_full_width"/>
                        </page>

                        <page string="Raw JSON" groups="base.group_system">
                            <field name="raw_message_json" widget="text" class="oe_full_width"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quo_texts" model="ir.actions.act_window">
        <field name="name">Quo Texts</field>
        <field name="res_model">quo.text</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
