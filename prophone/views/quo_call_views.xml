<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- CALLS -->
    <record id="view_quo_call_tree" model="ir.ui.view">
        <field name="name">quo.call.tree</field>
        <field name="model">quo.call</field>
        <!-- Explicit active=True: if this view was ever deactivated in the
             database (Odoo disables views that fail validation, and a v17 arch
             does not validate on v19), a plain module update would NOT switch it
             back on, because the XML did not set the field. Odoo then falls back
             to the auto-generated form, which renders every field on the model —
             including the whole mail.thread / mail.activity.mixin set. -->
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list>
                <field name="started_at"/>
                <field name="name" string="Call"/>
                <field name="direction"/>
                <field name="caller_from_partner_id" string="From"/>
                <field name="caller_to_partner_id" string="To"/>
                <field name="duration_seconds" string="Duration (s)" sum="Total"/>
                <field name="quo_call_id" column_invisible="1"/>
                <field name="phone_number_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_quo_call_form" model="ir.ui.view">
        <field name="name">quo.call.form</field>
        <field name="model">quo.call</field>
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <!-- Smart buttons. Must be the first element in the sheet:
                         that is what floats them to the top-right of the form. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_related_quotes"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="quote_count" widget="statinfo" string="Quotes"/>
                        </button>
                        <button name="action_view_related_opportunities"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-star">
                            <field name="opportunity_count" widget="statinfo" string="Opportunities"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="o_row mt-1">
                            <span class="text-muted me-2">Between</span>
                            <field name="caller_from_partner_id" options="{'no_create': False}" class="oe_inline"/>
                            <span class="text-muted mx-2">and</span>
                            <field name="caller_to_partner_id" options="{'no_create': False}" class="oe_inline"/>
                        </div>
                    </div>

                    <!-- Two sibling groups inside one outer group = two columns.
                         The previous single nested group rendered one narrow
                         column with the rest of the sheet blank. -->
                    <group string="Call Details">
                        <group name="timing">
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="duration_seconds" string="Duration (s)" readonly="1"/>
                        </group>
                        <group name="routing">
                            <field name="direction" readonly="1"/>
                            <field name="from_number" readonly="1"/>
                            <field name="to_number" readonly="1"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   string="Participants" readonly="1"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Transcript" name="transcript">
                            <field name="transcript_id" nolabel="1" context="{'default_call_id': id}">
                                <list>
                                    <field name="created_at"/>
                                    <field name="status"/>
                                    <field name="duration_seconds" string="Duration (s)"/>
                                </list>
                            </field>
                        </page>

                        <page string="Summary" name="summary">
                            <group>
                                <field name="summary_text" nolabel="1"
                                       placeholder="No summary yet..."/>
                            </group>
                            <separator string="Next Steps"/>
                            <group>
                                <field name="next_steps_text" nolabel="1"
                                       placeholder="No next steps yet..."/>
                            </group>
                        </page>

                        <page string="Recording" name="recording">
                            <group>
                                <field name="recording_url" widget="url" readonly="1"/>
                                <field name="recording_duration_seconds"
                                       string="Recording Duration (s)" readonly="1"/>
                                <field name="recording_mimetype" readonly="1"/>
                            </group>
                        </page>

                        <page string="Technical" name="technical" groups="base.group_system">
                            <group>
                                <field name="quo_call_id" readonly="1"/>
                                <field name="phone_number_id" readonly="1"/>
                                <field name="from_sanitized" readonly="1"/>
                                <field name="to_sanitized" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_quo_calls" model="ir.actions.act_window">
        <field name="name">Quo Calls</field>
        <field name="res_model">quo.call</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- TRANSCRIPTS -->
    <record id="view_quo_transcript_tree" model="ir.ui.view">
        <field name="name">quo.call.transcript.tree</field>
        <field name="model">quo.call.transcript</field>
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list>
                <field name="quo_call_id"/>
                <field name="created_at"/>
                <field name="status"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_quo_transcript_form" model="ir.ui.view">
        <field name="name">quo.call.transcript.form</field>
        <field name="model">quo.call.transcript</field>
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="call_id" readonly="1"/>
                        <field name="created_at" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="duration_seconds" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Dialogue">
                            <field name="line_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <!-- <field name="sequence"/> -->
                                    <field name="speaker_label" string="Phone #"/>
                                    <field name="start_ms"/>
                                    <field name="end_ms"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>

                        <!-- <page string="Raw JSON">
                            <field name="raw_transcript_json" widget="text"/>
                        </page> -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quo_transcripts" model="ir.actions.act_window">
        <field name="name">Quo Transcripts</field>
        <field name="res_model">quo.call.transcript</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- TEXTS -->
    <record id="view_quo_text_tree" model="ir.ui.view">
        <field name="name">quo.text.tree</field>
        <field name="model">quo.text</field>
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list>
                <field name="created_at"/>
                <field name="direction"/>
                <field name="from_partner_id"/>
                <field name="to_partner_id"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="view_quo_text_form" model="ir.ui.view">
        <field name="name">quo.text.form</field>
        <field name="model">quo.text</field>
        <field name="priority">1</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                        <div class="o_row mt-1">
                            <span class="text-muted me-2">Between</span>
                            <field name="from_partner_id" options="{'no_create': False}" class="oe_inline"/>
                            <span class="text-muted mx-2">and</span>
                            <field name="to_partner_id" options="{'no_create': False}" class="oe_inline"/>
                        </div>
                    </div>

                    <group string="Text details">
                        <group>
                            <field name="created_at"/>
                            <field name="direction"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="phone_number_id" groups="base.group_system"/>
                            <field name="conversation_id" groups="base.group_system"/>
                            <field name="quo_message_id" groups="base.group_system"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Message">
                            <field name="body" nolabel="1" class="oe_full_width"/>
                            <separator string="Media"/>
                            <field name="media_json" nolabel="1" widget="text" class="oe_full_width"/>
                        </page>

                        <page string="Raw JSON" groups="base.group_system">
                            <field name="raw_message_json" widget="text" class="oe_full_width"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quo_texts" model="ir.actions.act_window">
        <field name="name">Quo Texts</field>
        <field name="res_model">quo.text</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
