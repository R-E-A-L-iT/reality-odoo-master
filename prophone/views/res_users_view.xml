<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_inherit_quo_numbers" model="ir.ui.view">
        <field name="name">res.users.form.inherit.quo.numbers</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Put it somewhere reliable: after 'Groups' or in Preferences -->
            <xpath expr="//field[@name='company_ids']]" position="after">
                <field name="allowed_quo_phone_number_ids" widget="many2many_tags" domain="[('active', '=', True)]"/>
            </xpath>

        </field>
    </record>
</odoo>