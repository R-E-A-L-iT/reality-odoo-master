<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_quo_calls" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.quo.calls</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_view_quo_calls"
                        class="oe_stat_button"
                        icon="fa-phone">
                    <field name="quo_calls_count" widget="statinfo" string="Calls"/>
                </button>

                <button type="object"
                        name="action_view_quo_texts"
                        class="oe_stat_button"
                        icon="fa-comment">
                    <field name="quo_texts_count" widget="statinfo" string="Texts"/>
                </button>
            </xpath>

            <xpath expr="//div[hasclass('d-flex') and hasclass('flex-column') and hasclass('flex-grow-1')]" position="inside">
                <div class="o_row" groups="base.group_system">
                    <field name="quo_ignore_as_customer" widget="boolean_toggle"/>
                    <label for="quo_ignore_as_customer" string="Ignore for Quo (not a customer)"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>