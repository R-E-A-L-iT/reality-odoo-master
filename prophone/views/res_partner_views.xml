<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_quo_calls" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.quo.calls</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="quo_has_valid_phone" invisible="1"/>

                <button name="action_send_quo_text"
                        type="object"
                        string="Send Text"
                        class="oe_stat_button"
                        icon="fa-paper-plane"
                        attrs="{'invisible': [('quo_has_valid_phone', '=', False)]}"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_view_quo_calls"
                        class="oe_stat_button"
                        icon="fa-phone">
                    <field name="quo_calls_count" widget="statinfo" string="Calls"/>
                </button>

                <button type="object"
                        name="action_view_quo_texts"
                        class="oe_stat_button"
                        icon="fa-comment">
                    <field name="quo_texts_count" widget="statinfo" string="Texts"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>