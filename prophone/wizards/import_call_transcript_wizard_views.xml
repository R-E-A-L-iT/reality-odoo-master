<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_quo_import_transcript_wizard_form" model="ir.ui.view">
        <field name="name">quo.import.call.transcript.wizard.form</field>
        <field name="model">quo.import.call.transcript.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Transcript">
                <group>
                    <field name="quo_call_id" placeholder="Paste Quo Call ID"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quo_import_transcript_wizard" model="ir.actions.act_window">
        <field name="name">Import Transcript</field>
        <field name="res_model">quo.import.call.transcript.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
