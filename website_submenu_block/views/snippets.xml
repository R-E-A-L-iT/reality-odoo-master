<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Extend the default snippets to add our submenu block -->
<template id="submenu_block_snippet" inherit_id="website.snippets">
    <xpath expr="//div[@id='snippet_structure']//div[@class='o_panel_body']" position="inside">
        <t t-snippet="website_submenu_block.s_submenu_block" 
           string="Submenu Block" 
           t-thumbnail="/website_submenu_block/static/src/img/snippets_thumbs/s_submenu_block.svg">
            <keywords>navigation, menu, submenu, sticky, anchor</keywords>
        </t>
    </xpath>
</template>

<!-- Snippet options for customization -->
<template id="snippet_options" inherit_id="web_editor.snippet_options">
    
    <!-- Submenu Block Options -->
    <xpath expr="." position="inside">
        <div data-js="SubmenuBlock" 
             data-selector=".s_submenu_block"
             data-exclude="">
            
            <!-- Add Link Button -->
            <we-button string="Add New Link" 
                       class="fa fa-plus o_we_bg_success" 
                       data-add-link=""
                       data-no-preview="true"
                       title="Add and manage submenu links"/>
            
            <we-separator/>
            
            <!-- Scroll Effect Options -->
            <we-select string="Scroll Effect" data-variable="submenu-scroll-effect">
                <we-button data-customize-website-variable="'standard'"
                           data-select-class="o_submenu_standard">Standard</we-button>
                <we-button data-customize-website-variable="'fixed'"
                           data-select-class="o_submenu_fixed">Fixed</we-button>
                <we-button data-customize-website-variable="'disappears'"
                           data-select-class="o_submenu_disappears">Disappears</we-button>
                <we-button data-customize-website-variable="'fade-out'"
                           data-select-class="o_submenu_fade_out">Fade Out</we-button>
            </we-select>
            
            <!-- Header Position Options -->
            <we-select string="Header Position" data-no-preview="true">
                <we-button data-select-class="">Regular</we-button>
                <we-button data-select-class="o_submenu_overlay">Over The Content</we-button>
                <we-button data-select-class="o_submenu_hidden">Hidden</we-button>
            </we-select>
            
            <we-separator/>
            
            <!-- Background Color -->
            <we-colorpicker string="Background Color" 
                           data-css-property="background-color"
                           data-select-style=""
                           data-exclude=""/>
            
            <!-- Text Color -->
            <we-colorpicker string="Text Color"
                           data-css-property="color"
                           data-select-style=""
                           data-exclude=""
                           data-target=".s_submenu_link"/>

            <!-- Border Color -->
            <we-colorpicker string="Border Color"
                           data-css-property="border-bottom-color"
                           data-select-style=""
                           data-exclude=""/>

            <!-- Border Width -->
            <we-input string="Border Width"
                     data-name="border_width_opt"
                     data-css-property="border-bottom-width"
                     data-select-style="0"
                     data-unit="px"/>

            <!-- Border Style -->
            <we-select string="Border Style"
                      data-css-property="border-bottom-style"
                      data-dependencies="border_width_opt">
                <we-button data-select-style="solid">Solid</we-button>
                <we-button data-select-style="dotted">Dotted</we-button>
                <we-button data-select-style="dashed">Dashed</we-button>
<!--                <we-button data-select-style="double">Double</we-button>-->
<!--                <we-button data-select-style="groove">Groove</we-button>-->
<!--                <we-button data-select-style="ridge">Ridge</we-button>-->
<!--                <we-button data-select-style="none">None</we-button>-->
            </we-select>

            <we-separator/>
            
            <!-- Spacing -->
            <we-select string="Spacing">
                <we-button data-select-class="py-2">Small</we-button>
                <we-button data-select-class="py-3" data-default="">Medium</we-button>
                <we-button data-select-class="py-4">Large</we-button>
            </we-select>
            
            <!-- Text Alignment -->
            <we-select string="Alignment">
                <we-button data-select-class="justify-content-start">Left</we-button>
                <we-button data-select-class="justify-content-center" data-default="">Center</we-button>
                <we-button data-select-class="justify-content-end">Right</we-button>
            </we-select>
            
        </div>
    </xpath>
</template>

</odoo>