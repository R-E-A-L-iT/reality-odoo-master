<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="crm_lead_opportinuity_custom_real" model="ir.ui.view">
        <field name="name">CRM_Lead_Backend_Form_REAL</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_company_id" />
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="opportunity_source" />
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="replace">
                <field name="stage_id" widget="statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" domain="['|', ('team_id', '=', team_id), ('team_id', '=', False)]" invisible="not active"/>
            </xpath>
            <xpath expr="//group[@name='categorization']" position="after">
                <group string="Opportunity Details">
                    <field name="opportunity_custom_status" />
                    <field name="opportunity_source" />
                    <field name="opportunity_sn" />
                    <field name="opportunity_notes" />
                    <field name="linkedin_link" />
                    <field name="opportunity_log"/>
                    <field name="opportunity_answer_date"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="leica_can_register" invisible="1"/>
                <field name="leica_registered" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Leica Information" name="leica_information">
                    <group string="Leica Lead Details" colspan="2">
                        <group string="Leica registration details">
                            <field name="leica_registered" string="Has the lead been registered already?" readonly="1"/>

                            <field name="leica_representative_id" />
                        </group>
                        <group string="End-user Requests">
                            <field name="leica_has_demo_request"/>
                            <field name="leica_has_pricing_request"/>
                            <field name="leica_has_meeting_request"/>
                        </group>

                        <group string="Optional Details">
                            <field name="date_deadline" string="Expected Purchase Date"/>
                            <field name="leica_quantity"/>
                        </group>

                        <group string="Extra Details">
                            <field name="leica_market_segment"/>
                            <field name="leica_product_interest"/>
                            <field name="leica_is_rfp"/>
                        </group>

                        <!-- (Optional) Show partner address (read-through) so users can fix it on the Contact) -->
                        <group string="Contact Address (from Customer)">
                            <field name="partner_street" readonly="1"/>
                            <field name="partner_city" readonly="1"/>
                            <field name="partner_state_id" readonly="1"/>
                            <field name="partner_zip" readonly="1"/>
                            <field name="partner_country_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='lead_priority']" position="after">
                <group string="Contact Information">
                    <field name="partner_name"/>
                    <label for="street_page_lead" string="Address"/>
                    <div class="o_address_format">
                        <field name="street" id="street_page_lead" placeholder="Street..." class="o_address_street"/>
                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                        <field name="city" placeholder="City" class="o_address_city"/>
                        <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}"/>
                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                        <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                    </div>
                    <field name="website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                    <field name="lang_active_count" invisible="1"/>
                    <field name="lang_id" invisible="lang_active_count &lt;= 1" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </group>
                <group class="mt48">
                    <label for="contact_name_page_lead"/>
                    <div class="o_row">
                        <field name="contact_name" id="contact_name_page_lead"/>
                        <field name="title" placeholder="Title" domain="[]" options="{&quot;no_open&quot;: True}"/>
                    </div>
                    <field name="function"/>
                    <label for="mobile_page_lead" class="oe_inline"/>
                    <div class="o_row o_row_readonly">
                        <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger" title="This phone number is blacklisted for SMS Marketing. Click to unblacklist." type="object" context="{'default_phone': mobile}" groups="base.group_user" invisible="not mobile_blacklisted"/>
                        <field name="mobile" id="mobile_page_lead" widget="phone"/>
                    </div>
                </group>
                <group name="ba_email_subject_group" string="Email Settings" invisible="type != 'opportunity'">
                    <field name="ba_email_subject"
                           string="Email Subject"
                           placeholder="Enter the email subject for outgoing emails..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>