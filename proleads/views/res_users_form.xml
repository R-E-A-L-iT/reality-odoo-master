<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_leica_reminder" model="ir.ui.view">
        <field name="name">res.users.form.leica.reminder</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name=&quot;company_id&quot;]" position="after">
                <group string="Leica">
                    <field name="leica_lead_reminder"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="proquotes_internal_user_profile_backend" model="ir.ui.view">
        <field name="name">Internal User Profile Backend</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="after">
                <field name="leica_lead_reminder"/>
            </xpath>
        </field>
    </record>
</odoo>
