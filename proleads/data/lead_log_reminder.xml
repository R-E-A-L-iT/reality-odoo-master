<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_crm_lead_leica_reminder" model="mail.template">
        <field name="name">Leica Lead Reminder (on Create)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Reminder: Log “${object.name}” in the Leica portal</field>
        <field name="email_from">${(object.company_id.email or user.email or 'notifications@%s' % (object.company_id and object.company_id.website or 'example.com'))|safe}</field>
        <field name="email_layout_xmlid">mail.mail_notification_light</field>
        <field name="body_html" type="html">
            <![CDATA[
                <div>
                <p>Hello,</p>
                <p>
                    This is a reminder to log the lead <strong>${object.name}</strong> in the Leica portal.
                </p>
                <p>Thanks.</p>
                </div>
            ]]>
        </field>
        <field name="email_from">${(user.company_id.email) or ''}</field>
    </record>
</odoo>

