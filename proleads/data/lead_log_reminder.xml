<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mail_template_crm_lead_leica_reminder" model="mail.template">
    <field name="name">Leica Lead Reminder (on Create)</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="subject">Reminder: Log “${object.name}” in the Leica portal</field>

    <!-- use the normal layout -->
    <field name="email_layout_xmlid">mail.mail_notification_light</field>

    <!-- we'll override recipients in code so this stays empty -->
    <field name="email_to"/>
    <field name="auto_delete" eval="True"/>

    <!-- sender: prefer user's formatted email, fall back to company -->
    <field name="email_from">
      ${(user.email_formatted or (user.company_id.email_formatted or ''))}
    </field>

    <field name="body_html" type="html"><![CDATA[
      <p>Hello,</p>
      <p>This is a reminder to log the lead <strong>${object.name}</strong> in the Leica portal.</p>
      <p>Thanks.</p>
    ]]></field>
  </record>
</odoo>
