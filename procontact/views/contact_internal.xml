<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_partner_form_procontact" model="ir.ui.view">
        <field name="name">Partner_Backend_Form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='title']" position="after">
                <field name="linkedin_link" />
                <field name="is_customer" />
                <field name="parent_company_id" invisible="not is_company"/>
            </xpath>

            <xpath expr="//sheet/group" position="before">
                <group>
                    <field name="first_name" widget="CopyClipboardChar" string="First Name" readonly="1"/>
                    <field name="last_name" widget="CopyClipboardChar" string="Last Name" eadonly="1"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='email']" position="replace">
                <field name="email" widget="CopyClipboardChar" string="Email"/>
            </xpath>

            <xpath expr="//field[@name='phone']" position="replace">
                <field name="phone" widget="CopyClipboardChar" string="Phone"/>
            </xpath>

            <xpath expr="//field[@name='zip']" position="replace">
                <field name="zip" widget="CopyClipboardChar" string="ZIP Code"/>
            </xpath>

            <xpath expr="//field[@name='street']" position="replace">
                <field name="street" widget="CopyClipboardChar" string="Street"/>
            </xpath>

            <xpath expr="//field[@name='city']" position="replace">
                <field name="city" widget="CopyClipboardChar" string="City"/>
            </xpath>

            <xpath expr="//field[@name='website']" position="replace">
                <field name="website" widget="CopyClipboardChar" string="Website"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Branches" invisible="not is_company">
                    <field name="branch_company_ids" nolabel="1" readonly="1">
                        <tree string="Branches">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>