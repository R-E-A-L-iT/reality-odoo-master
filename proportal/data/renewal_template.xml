<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="tmpl_ccp_renewal_reminder" model="mail.template">
    <field name="name">CCP Renewal Reminder</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="subject">Your CCP(s) will expire soon</field>
    <field name="email_layout_xmlid">mail.mail_notification_light</field>
    <field name="body_html"><![CDATA[
<p>Hello,</p>
<p>This is a reminder that your following CCPs will be expiring within the next month:</p>
<t t-out="ctx.get('items_html') or ''"/>
<p>If you'd like to renew these CCPs, please feel free to contact us at 
<a href="mailto:experts@r-e-a-l.it">experts@r-e-a-l.it</a> to get a new quote.</p>
<p>Thank you.</p>
]]></field>
    <field name="auto_delete" eval="False"/>
    <field name="email_from">${(object.email or user.company_id.email) or ''}</field>
  </record>
</odoo>
