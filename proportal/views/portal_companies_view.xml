<odoo>
  <!-- Company settings DETAIL page -->
  <template id="portal_company_settings_detail" name="Company Settings Detail">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-set="language" t-value="request.lang.code" />
      <t t-call="portal.portal_searchbar">
        <t t-set="title" t-if="language == 'fr_CA'">Paramètres de l'entreprise</t>
        <t t-set="title" t-elif="language == 'es_ES'">Configuración de la empresa</t>
        <t t-set="title" t-else="">Company Settings</t>
      </t>

      <div class="d-flex align-items-center mb-3">
        <a class="btn btn-light me-2" href="/my/company-settings" t-if="language == 'fr_CA'">← Retour</a>
        <a class="btn btn-light me-2" href="/my/company-settings" t-elif="language == 'es_ES'">← Volver</a>
        <a class="btn btn-light me-2" href="/my/company-settings" t-else="">← Back</a>
        <h3 class="m-0">
          <t t-esc="company.name"/> <t t-if="language == 'fr_CA'">— Paramètres du contact</t><t t-elif="language == 'es_ES'">— Configuración del contacto</t><t t-else="">— Contact Settings</t>
        </h3>
      </div>

      <!-- <div class="alert alert-info mb-4">
        These forms are for preview/UX only right now. Submissions are disabled and do not update data yet.
      </div> -->

      <!-- ===== ADDRESS CARD SELECTOR ===== -->
      <div id="company-address-section" t-att-data-company-id="company.id" class="mb-4">

        <!-- Localized labels -->
        <t t-set="lbl_name"          t-value="'Nom' if language == 'fr_CA' else ('Nombre' if language == 'es_ES' else 'Name')"/>
        <t t-set="lbl_street"        t-value="'Rue' if language == 'fr_CA' else ('Calle' if language == 'es_ES' else 'Street')"/>
        <t t-set="lbl_city"          t-value="'Ville' if language == 'fr_CA' else ('Ciudad' if language == 'es_ES' else 'City')"/>
        <t t-set="lbl_country"       t-value="'Pays' if language == 'fr_CA' else ('País' if language == 'es_ES' else 'Country')"/>
        <t t-set="lbl_state"         t-value="'État/Province' if language == 'fr_CA' else ('Estado' if language == 'es_ES' else 'State/Province')"/>
        <t t-set="lbl_zip"           t-value="'Code postal' if language == 'fr_CA' else ('Código postal' if language == 'es_ES' else 'Zip/Postal Code')"/>
        <t t-set="lbl_add"           t-value="'Ajouter une adresse' if language == 'fr_CA' else ('Agregar dirección' if language == 'es_ES' else 'Add Address')"/>
        <t t-set="lbl_edit_title"    t-value="'Modifier' if language == 'fr_CA' else ('Editar' if language == 'es_ES' else 'Edit')"/>
        <t t-set="lbl_delete_title"  t-value="'Supprimer' if language == 'fr_CA' else ('Eliminar' if language == 'es_ES' else 'Delete')"/>
        <t t-set="lbl_save_title"    t-value="'Enregistrer' if language == 'fr_CA' else ('Guardar' if language == 'es_ES' else 'Save')"/>
        <t t-set="lbl_cancel_title"  t-value="'Annuler' if language == 'fr_CA' else ('Cancelar' if language == 'es_ES' else 'Cancel')"/>
        <t t-set="lbl_default_badge" t-value="'Défaut' if language == 'fr_CA' else ('Predeterminado' if language == 'es_ES' else 'Default')"/>

        <!-- Hidden option lists: JS clones these when building blank "Add Address" cards -->
        <select id="addr-country-options-template" style="display:none;" tabindex="-1" aria-hidden="true">
          <option value=""><t t-esc="lbl_country"/></option>
          <t t-foreach="priority_countries" t-as="c">
            <option t-att-value="c.id" t-esc="c.name"/>
          </t>
          <option value="" disabled="disabled">──────────</option>
          <t t-foreach="other_countries" t-as="c">
            <option t-att-value="c.id" t-esc="c.name"/>
          </t>
        </select>
        <select id="addr-state-options-template" style="display:none;" tabindex="-1" aria-hidden="true">
          <option value=""><t t-esc="lbl_state"/></option>
          <t t-foreach="ca_states" t-as="s">
            <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name"/>
          </t>
          <option value="" disabled="disabled">──────────</option>
          <t t-foreach="us_states" t-as="s">
            <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name"/>
          </t>
          <option value="" disabled="disabled">──────────</option>
          <t t-foreach="other_states" t-as="s">
            <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name"/>
          </t>
        </select>

        <!-- ===== DELIVERY ADDRESS ===== -->
        <div class="addr_matrix">
          <div class="addr_hdr">
            <h4 t-if="language == 'fr_CA'">Adresse de livraison</h4>
            <h4 t-elif="language == 'es_ES'">Dirección de entrega</h4>
            <h4 t-else="">Delivery Address</h4>
          </div>

          <div class="addr_cards" id="delivery-address-cards">
            <t t-set="delivery_list" t-value="default_partner + delivery_addresses"/>
            <t t-foreach="delivery_list" t-as="addr">
              <t t-set="is_fallback"  t-value="addr.id == default_partner.id"/>
              <t t-set="address_type" t-value="'delivery'"/>
              <div t-attf-class="addr_card"
                   t-att-data-partner-id="addr.id"
                   t-att-data-address-type="address_type"
                   t-att-data-fallback="'1' if is_fallback else None"
                   t-att-data-name="addr.name or ''"
                   t-att-data-street="addr.street or ''"
                   t-att-data-city="addr.city or ''"
                   t-att-data-zip="addr.zip or ''"
                   t-att-data-country-id="addr.country_id.id or ''"
                   t-att-data-state-id="addr.state_id.id or ''">
                <!-- VIEW MODE -->
                <div class="addr_card_view">
                  <div class="addr_card_actions">
                    <button class="addr_action_btn addr_edit_btn" t-att-title="lbl_edit_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button t-if="not is_fallback" class="addr_action_btn addr_delete_btn" t-att-title="lbl_delete_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <span class="addr_badge" t-if="is_fallback" t-esc="lbl_default_badge"/>
                  <div class="name" t-esc="addr.name"/>
                  <div class="lines">
                    <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                    <t t-if="addr.city or addr.state_id or addr.zip">
                      <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                      <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                      <t t-if="addr.zip"><t t-esc="addr.zip"/></t>
                      <br/>
                    </t>
                    <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                  </div>
                </div>
                <!-- EDIT MODE -->
                <div class="addr_card_edit" style="display:none;">
                  <div class="addr_card_actions">
                    <button class="addr_action_btn addr_save_btn" t-att-title="lbl_save_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polyline points="1.5 6.5 4.5 9.5 10.5 2.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button class="addr_action_btn addr_cancel_btn" t-att-title="lbl_cancel_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="edit_row"><input type="text" class="edit-name"   t-att-value="addr.name or ''"   t-att-placeholder="lbl_name"/></div>
                  <div class="edit_row"><input type="text" class="edit-street" t-att-value="addr.street or ''" t-att-placeholder="lbl_street"/></div>
                  <div class="edit_row"><input type="text" class="edit-city"   t-att-value="addr.city or ''"   t-att-placeholder="lbl_city"/></div>
                  <div class="edit_row edit_row--split">
                    <select class="edit-country">
                      <option value=""><t t-esc="lbl_country"/></option>
                      <t t-foreach="priority_countries" t-as="c">
                        <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="other_countries" t-as="c">
                        <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                      </t>
                    </select>
                    <select class="edit-state">
                      <option value=""><t t-esc="lbl_state"/></option>
                      <t t-foreach="ca_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="us_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="other_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                    </select>
                  </div>
                  <div class="edit_row"><input type="text" class="edit-zip" t-att-value="addr.zip or ''" t-att-placeholder="lbl_zip"/></div>
                </div>
              </div>
            </t>
            <div class="addr_card add_card" id="new-address-trigger-delivery">
              <div class="add_inner">
                <i class="fa fa-plus"/>
                <span class="add_label" t-esc="lbl_add"/>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== INVOICE ADDRESS ===== -->
        <div class="addr_matrix">
          <div class="addr_hdr">
            <h4 t-if="language == 'fr_CA'">Adresse de facturation</h4>
            <h4 t-elif="language == 'es_ES'">Dirección de facturación</h4>
            <h4 t-else="">Invoice Address</h4>
          </div>

          <div class="addr_cards" id="invoice-address-cards">
            <t t-set="invoice_list" t-value="default_partner + invoice_addresses"/>
            <t t-foreach="invoice_list" t-as="addr">
              <t t-set="is_fallback"  t-value="addr.id == default_partner.id"/>
              <t t-set="address_type" t-value="'invoice'"/>
              <div t-attf-class="addr_card"
                   t-att-data-partner-id="addr.id"
                   t-att-data-address-type="address_type"
                   t-att-data-fallback="'1' if is_fallback else None"
                   t-att-data-name="addr.name or ''"
                   t-att-data-street="addr.street or ''"
                   t-att-data-city="addr.city or ''"
                   t-att-data-zip="addr.zip or ''"
                   t-att-data-country-id="addr.country_id.id or ''"
                   t-att-data-state-id="addr.state_id.id or ''">
                <!-- VIEW MODE -->
                <div class="addr_card_view">
                  <div class="addr_card_actions">
                    <button class="addr_action_btn addr_edit_btn" t-att-title="lbl_edit_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button t-if="not is_fallback" class="addr_action_btn addr_delete_btn" t-att-title="lbl_delete_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <span class="addr_badge" t-if="is_fallback" t-esc="lbl_default_badge"/>
                  <div class="name" t-esc="addr.name"/>
                  <div class="lines">
                    <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                    <t t-if="addr.city or addr.state_id or addr.zip">
                      <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                      <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                      <t t-if="addr.zip"><t t-esc="addr.zip"/></t>
                      <br/>
                    </t>
                    <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                  </div>
                </div>
                <!-- EDIT MODE -->
                <div class="addr_card_edit" style="display:none;">
                  <div class="addr_card_actions">
                    <button class="addr_action_btn addr_save_btn" t-att-title="lbl_save_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polyline points="1.5 6.5 4.5 9.5 10.5 2.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button class="addr_action_btn addr_cancel_btn" t-att-title="lbl_cancel_title">
                      <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="edit_row"><input type="text" class="edit-name"   t-att-value="addr.name or ''"   t-att-placeholder="lbl_name"/></div>
                  <div class="edit_row"><input type="text" class="edit-street" t-att-value="addr.street or ''" t-att-placeholder="lbl_street"/></div>
                  <div class="edit_row"><input type="text" class="edit-city"   t-att-value="addr.city or ''"   t-att-placeholder="lbl_city"/></div>
                  <div class="edit_row edit_row--split">
                    <select class="edit-country">
                      <option value=""><t t-esc="lbl_country"/></option>
                      <t t-foreach="priority_countries" t-as="c">
                        <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="other_countries" t-as="c">
                        <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                      </t>
                    </select>
                    <select class="edit-state">
                      <option value=""><t t-esc="lbl_state"/></option>
                      <t t-foreach="ca_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="us_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                      <option value="" disabled="disabled">──────────</option>
                      <t t-foreach="other_states" t-as="s">
                        <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                      </t>
                    </select>
                  </div>
                  <div class="edit_row"><input type="text" class="edit-zip" t-att-value="addr.zip or ''" t-att-placeholder="lbl_zip"/></div>
                </div>
              </div>
            </t>
            <div class="addr_card add_card" id="new-address-trigger-invoice">
              <div class="add_inner">
                <i class="fa fa-plus"/>
                <span class="add_label" t-esc="lbl_add"/>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== FOLLOW-UP ADDRESS ===== -->
      <div class="addr_matrix">
        <div class="addr_hdr">
          <h4 t-if="language == 'fr_CA'">Adresse de suivi</h4>
          <h4 t-elif="language == 'es_ES'">Dirección de seguimiento</h4>
          <h4 t-else="">Follow-up Address</h4>
        </div>
        <div class="addr_cards" id="followup-address-cards">
          <t t-set="followup_list" t-value="default_partner + followup_addresses"/>
          <t t-foreach="followup_list" t-as="addr">
            <t t-set="is_fallback"  t-value="addr.id == default_partner.id"/>
            <t t-set="address_type" t-value="'followup'"/>
            <div t-attf-class="addr_card"
                 t-att-data-partner-id="addr.id"
                 t-att-data-address-type="address_type"
                 t-att-data-fallback="'1' if is_fallback else None"
                 t-att-data-name="addr.name or ''"
                 t-att-data-street="addr.street or ''"
                 t-att-data-city="addr.city or ''"
                 t-att-data-zip="addr.zip or ''"
                 t-att-data-country-id="addr.country_id.id or ''"
                 t-att-data-state-id="addr.state_id.id or ''">
              <div class="addr_card_view">
                <div class="addr_card_actions">
                  <button class="addr_action_btn addr_edit_btn" t-att-title="lbl_edit_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button t-if="not is_fallback" class="addr_action_btn addr_delete_btn" t-att-title="lbl_delete_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <span class="addr_badge" t-if="is_fallback" t-esc="lbl_default_badge"/>
                <div class="name" t-esc="addr.name"/>
                <div class="lines">
                  <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                  <t t-if="addr.city or addr.state_id or addr.zip">
                    <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                    <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                    <t t-if="addr.zip"><t t-esc="addr.zip"/></t><br/>
                  </t>
                  <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                </div>
              </div>
              <div class="addr_card_edit" style="display:none;">
                <div class="addr_card_actions">
                  <button class="addr_action_btn addr_save_btn" t-att-title="lbl_save_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <polyline points="1.5 6.5 4.5 9.5 10.5 2.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button class="addr_action_btn addr_cancel_btn" t-att-title="lbl_cancel_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
                <div class="edit_row"><input type="text" class="edit-name"   t-att-value="addr.name or ''"   t-att-placeholder="lbl_name"/></div>
                <div class="edit_row"><input type="text" class="edit-street" t-att-value="addr.street or ''" t-att-placeholder="lbl_street"/></div>
                <div class="edit_row"><input type="text" class="edit-city"   t-att-value="addr.city or ''"   t-att-placeholder="lbl_city"/></div>
                <div class="edit_row edit_row--split">
                  <select class="edit-country">
                    <option value=""><t t-esc="lbl_country"/></option>
                    <t t-foreach="priority_countries" t-as="c">
                      <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="other_countries" t-as="c">
                      <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                    </t>
                  </select>
                  <select class="edit-state">
                    <option value=""><t t-esc="lbl_state"/></option>
                    <t t-foreach="ca_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="us_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="other_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                  </select>
                </div>
                <div class="edit_row"><input type="text" class="edit-zip" t-att-value="addr.zip or ''" t-att-placeholder="lbl_zip"/></div>
              </div>
            </div>
          </t>
          <div class="addr_card add_card" id="new-address-trigger-followup">
            <div class="add_inner">
              <i class="fa fa-plus"/>
              <span class="add_label" t-esc="lbl_add"/>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== RENEWAL CONTACT ===== -->
      <div class="addr_matrix">
        <div class="addr_hdr">
          <h4 t-if="language == 'fr_CA'">Contact de renouvellement</h4>
          <h4 t-elif="language == 'es_ES'">Contacto de renovación</h4>
          <h4 t-else="">Renewal Contact</h4>
        </div>
        <div class="addr_cards" id="renewal-address-cards">
          <t t-set="renewal_list" t-value="default_partner + renewal_addresses"/>
          <t t-foreach="renewal_list" t-as="addr">
            <t t-set="is_fallback"  t-value="addr.id == default_partner.id"/>
            <t t-set="address_type" t-value="'renewal'"/>
            <div t-attf-class="addr_card"
                 t-att-data-partner-id="addr.id"
                 t-att-data-address-type="address_type"
                 t-att-data-fallback="'1' if is_fallback else None"
                 t-att-data-name="addr.name or ''"
                 t-att-data-street="addr.street or ''"
                 t-att-data-city="addr.city or ''"
                 t-att-data-zip="addr.zip or ''"
                 t-att-data-country-id="addr.country_id.id or ''"
                 t-att-data-state-id="addr.state_id.id or ''">
              <div class="addr_card_view">
                <div class="addr_card_actions">
                  <button class="addr_action_btn addr_edit_btn" t-att-title="lbl_edit_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8.5 1.5L10.5 3.5L4 10H2V8L8.5 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button t-if="not is_fallback" class="addr_action_btn addr_delete_btn" t-att-title="lbl_delete_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 3h8M5 3V2h2v1M4 3v6h4V3H4z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <span class="addr_badge" t-if="is_fallback" t-esc="lbl_default_badge"/>
                <div class="name" t-esc="addr.name"/>
                <div class="lines">
                  <t t-if="addr.street"><t t-esc="addr.street"/><br/></t>
                  <t t-if="addr.city or addr.state_id or addr.zip">
                    <t t-if="addr.city"><t t-esc="addr.city"/><t t-if="addr.state_id or addr.zip">, </t></t>
                    <t t-if="addr.state_id"><t t-esc="addr.state_id.name"/> </t>
                    <t t-if="addr.zip"><t t-esc="addr.zip"/></t><br/>
                  </t>
                  <t t-if="addr.country_id"><t t-esc="addr.country_id.name"/></t>
                </div>
              </div>
              <div class="addr_card_edit" style="display:none;">
                <div class="addr_card_actions">
                  <button class="addr_action_btn addr_save_btn" t-att-title="lbl_save_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <polyline points="1.5 6.5 4.5 9.5 10.5 2.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button class="addr_action_btn addr_cancel_btn" t-att-title="lbl_cancel_title">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
                <div class="edit_row"><input type="text" class="edit-name"   t-att-value="addr.name or ''"   t-att-placeholder="lbl_name"/></div>
                <div class="edit_row"><input type="text" class="edit-street" t-att-value="addr.street or ''" t-att-placeholder="lbl_street"/></div>
                <div class="edit_row"><input type="text" class="edit-city"   t-att-value="addr.city or ''"   t-att-placeholder="lbl_city"/></div>
                <div class="edit_row edit_row--split">
                  <select class="edit-country">
                    <option value=""><t t-esc="lbl_country"/></option>
                    <t t-foreach="priority_countries" t-as="c">
                      <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="other_countries" t-as="c">
                      <option t-att-value="c.id" t-esc="c.name" t-att-selected="c.id == addr.country_id.id"/>
                    </t>
                  </select>
                  <select class="edit-state">
                    <option value=""><t t-esc="lbl_state"/></option>
                    <t t-foreach="ca_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="us_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                    <option value="" disabled="disabled">──────────</option>
                    <t t-foreach="other_states" t-as="s">
                      <option t-att-value="s.id" t-att-data-country-id="s.country_id.id" t-esc="s.name" t-att-selected="s.id == addr.state_id.id"/>
                    </t>
                  </select>
                </div>
                <div class="edit_row"><input type="text" class="edit-zip" t-att-value="addr.zip or ''" t-att-placeholder="lbl_zip"/></div>
              </div>
            </div>
          </t>
          <div class="addr_card add_card" id="new-address-trigger-renewal">
            <div class="add_inner">
              <i class="fa fa-plus"/>
              <span class="add_label" t-esc="lbl_add"/>
            </div>
          </div>
        </div>
      </div>

      </div>
      <!-- ===== END ADDRESS CARD SELECTOR ===== -->

    </t>
  </template>
  <!-- Company Settings page -->
  <template id="portal_company_settings" name="Company Settings">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-call="portal.portal_searchbar">
        <t t-set="title">Company Settings</t>
      </t>

      <t t-if="not companies">
        <p>No companies found.</p>
      </t>

      <t t-if="companies" t-call="portal.portal_table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Street</th>
            <th>City</th>
            <th>Country</th>
          </tr>
        </thead>
        <t t-foreach="companies" t-as="c">
          <tr>
            <td>
                <a t-attf-href="/my/company-settings/#{c.id}">
                    <t t-esc="c.name"/>
                </a>
            </td>
            <td><t t-esc="c.email or ''"/></td>
            <td><t t-esc="c.phone or ''"/></td>
            <td><t t-esc="c.street or ''"/></td>
            <td><t t-esc="c.city or ''"/></td>
            <td><t t-esc="c.country_id and c.country_id.name or ''"/></td>
          </tr>
        </t>
      </t>
    </t>
  </template>

  <template id="portal_my_home_company_settings_card" inherit_id="portal.portal_my_home" priority="40">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
      <t t-set="portal_client_category_enable" t-value="True"/>
    </xpath>
    <div id="portal_client_category" position="inside">
      <t t-if="request.env.user.partner_id.portal_administrator">
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Company-Settings.png'"/>
          <t t-set="text">Manage your company access &amp; info</t>
          <t t-set="title">Company Settings</t>
          <t t-set="url" t-value="'/my/company-settings'"/>
          <t t-set="placeholder_count" t-value="'-'" />
          <t t-set="config_card" t-value="True"/>
        </t>
      </t>
    </div>
  </template>
</odoo>