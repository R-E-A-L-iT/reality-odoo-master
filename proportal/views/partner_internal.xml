<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_partner_form_real_proportal" model="ir.ui.view">
        <field name="name">Partner.Backend.Form.real.proportal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <!-- company_nickname used to be injected after //field[@name='title'].
                 Odoo 19 removed the `title` field from the partner form, so that
                 anchor cannot be located and aborted the module update. Moved into
                 the Portal Settings page below, which hangs off //notebook — the
                 one anchor verified against this database. company_nickname is
                 required=True on the model, so it must stay reachable in the UI. -->
            <xpath expr="//notebook" position="inside">
                <page name="portal" string="Portal Settings">
                    <sheet>
                        <group string="Company Identification">
                            <field name="company_nickname" invisible="not is_company"/>
                        </group>
                        <group string="Portal Administration">
                            <field name="portal_administrator"/>
                            <field name="portal_companies_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
