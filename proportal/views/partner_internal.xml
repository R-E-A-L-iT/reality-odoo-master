<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_partner_form_real_proportal" model="ir.ui.view">
        <field name="name">Partner.Backend.Form.real.proportal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="after">
                <field name="company_nickname" invisible="not is_company" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="portal" string="Portal Settings">
                    <sheet>
                        <group string="Portal Administration">
                    <field name="portal_administrator"/>
                    <field name="portal_companies_ids" widget="many2many_tags"/>
                </group>
                    </sheet>
                </page>
            </xpath>
        </field>
    </record>
</odoo>