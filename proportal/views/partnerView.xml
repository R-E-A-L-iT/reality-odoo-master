<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">proportal.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"></field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <!-- //notebook is the only anchor in this file verified to exist in
                 the Odoo 19 partner form as it is actually stored in this DB
                 (ir.ui.view 118, which also carries Studio customisations). -->
            <xpath expr="//notebook" position="inside">
                <page name="products" string="Products">
                    <sheet>
                        <field name="products" domain="[('company_id', '=', 1)]" string="Products"/>
                    </sheet>
                </page>
            </xpath>

            <!-- TEMPORARILY REMOVED (2026-09-08) — re-add one at a time, testing
                 each with `odoo-bin -u proportal` before pushing.

                 1. Renewal-contact hint paragraph. Original anchor
                    //p[@invisible="type != 'contact'"] is the CONFIRMED cause of
                    every failed build/upgrade: Odoo 19 rewrote that paragraph.
                    A replacement anchored on
                    //field[@name='type'][@widget='radio'] exists in upstream 19.0
                    source but was never verified against this database.

                 2. Three attribute patches on the child-contact popup that made
                    type == 'renewal' behave like type == 'contact' (name required,
                    function div visible, other_info group hidden), anchored via
                    //field[@name='type'][@widget='radio']/ancestor::form[1].
                    Same unverified status.

                 BEHAVIOUR LOST until re-added: renewal contacts render in the
                 child-contact popup exactly like 'other' address types — name is
                 not required, the job-position field is hidden, and the address
                 group shows. The Renewal type itself, the CCP reminder cron, and
                 the Products tab are unaffected. -->
        </field>
    </record>
</odoo>
