<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">proportal.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"></field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="products" string="Products">
                    <sheet>
                        <!-- <div t-if="parent_id"> -->
                            <!-- <field name="parentProducts" string="Company Products"/> -->
                        <!-- </div> -->
                        <!-- <div t-if="company_type == 'company'"> -->
                            <field name="products" domain="[('company_id', '=', 1)]" string="Products"/>
                        <!-- </div> -->
                    </sheet>
                </page>
            </xpath>
            <!-- Anchored on the `type` field rather than on the core hint
                 paragraph: Odoo 19 rewrote that <p> and the old
                 //p[@invisible="type != 'contact'"] no longer matches, which
                 aborted the whole module upgrade. -->
            <xpath expr="//field[@name='type'][@widget='radio']" position="after">
                <p class="mb-0" invisible="type != 'renewal'">
                    <span>This contact will be treated as the default recipient for CCP renewal notifications.</span>
                </p>
            </xpath>
            <!-- Odoo 19 rewrote the child-contact popup form: `name` now lives
                 in an <h3> inside plain divs, with no <group> ancestor at all,
                 so the old
                   //form[.//field[@name='type' and @widget='radio']]
                       //field[@name='name']/ancestor::group[1]
                 replace matched nothing and would have aborted the upgrade.
                 That block only ever did one thing core doesn't: make
                 type == 'renewal' behave like type == 'contact'. Expressed as
                 attribute patches on the fields core already renders, which is
                 both smaller and robust against further layout changes.
                 `ancestor::form[1]` is a reverse axis, so it resolves to the
                 NEAREST enclosing form (the popup), not the outer partner form.
                 Dropped along the way, deliberately: `mobile` (removed from
                 res.partner in 19) and `title`, which the old block rendered
                 with an always-true invisible condition and so was never
                 actually visible. -->
            <xpath expr="//field[@name='type'][@widget='radio']/ancestor::form[1]//field[@name='name']" position="attributes">
                <attribute name="required">type in ('contact', 'renewal')</attribute>
            </xpath>
            <xpath expr="//field[@name='type'][@widget='radio']/ancestor::form[1]//field[@name='function']/ancestor::div[1]" position="attributes">
                <attribute name="invisible">is_company or type not in ('contact', 'renewal')</attribute>
            </xpath>
            <xpath expr="//field[@name='type'][@widget='radio']/ancestor::form[1]//group[@name='other_info']" position="attributes">
                <attribute name="invisible">type in ('contact', 'renewal')</attribute>
            </xpath>
        </field>
    </record> 
</odoo>