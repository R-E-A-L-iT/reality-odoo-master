<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_language_selector_globe" inherit_id="portal.language_selector">
        <!-- Replace the dropdown toggle link with a rounded globe icon -->
        <xpath expr="//a[@class='dropdown-toggle nav-link']" position="replace">
            <a role="button"
               class="nav-link dropdown-toggle d-flex align-items-center justify-content-center rounded-circle bg-dark text-white"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="fa fa-globe fa-lg"/>
            </a>
        </xpath>
    </template>
</odoo>
