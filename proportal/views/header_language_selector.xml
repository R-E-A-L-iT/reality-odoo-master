<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Replace the default language selector -->
    <template id="header_language_selector_icon" inherit_id="website.placeholder_header_language_selector">
        <xpath expr="." position="inside">
            <li t-attf-class="o_header_language_selector #{_item_class}">
                <t t-call="portal.language_selector">
                    <t t-set="_div_classes" t-value="(_div_classes or '') + ' dropdown'"/>
                    <t t-set="_a_classes" t-value="'nav-link dropdown-toggle d-flex align-items-center justify-content-center rounded-circle bg-dark text-white'"/>
                    <t t-set="_icon_class" t-value="'fa fa-globe fa-lg'"/>
                    <t t-set="_icon_style" t-value="'padding: 0.4rem; width: 2rem; height: 2rem; text-align: center;'"/>

                    <t t-jquery="a.dropdown-toggle" t-operation="replace">
                        <a role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           t-attf-class="#{_a_classes}"
                           t-att-data-language-code="language_code">
                            <i t-att-class="_icon_class" t-att-style="_icon_style"/>
                        </a>
                    </t>
                </t>
            </li>
        </xpath>
    </template>
</odoo>
