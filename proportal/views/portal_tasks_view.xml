<odoo>
  <template id="portal_my_project_collab" name="My Project (Collaborators)">
    <t t-call="portal.portal_layout">
      <t t-set="title" t-value="project.name"/>
      <t t-set="o_portal_fullwidth_alert" groups="project.group_project_user">
        <t t-call="portal.portal_back_in_edit_mode">
          <t t-set="backend_url" t-value="'/web#model=project.project&amp;id=%s&amp;view_type=kanban' % (project.id)"/>
        </t>
      </t>

      <!-- Header / search bar (keeps parity with stock) -->
      <t t-call="portal.portal_searchbar">
        <t t-set="title">Tasks</t>
      </t>

      <!-- Empty state -->
      <t t-if="not task_count">
        <div class="alert alert-warning" role="alert">There are no tasks.</div>
      </t>

      <!-- Task list (flat, collaborator-aware) -->
      <t t-else="">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Task</th>
              <th>Stage</th>
              <th>Assignees</th>
              <th>Deadline</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="tasks" t-as="t">
              <td>
                <a t-att-href="'/my/task/%s' % t.id"><t t-esc="t.name"/></a>
              </td>
              <td><t t-esc="t.stage_id and t.stage_id.display_name or ''"/></td>
              <td>
                <t t-if="t.user_ids">
                  <t t-foreach="t.user_ids" t-as="u">
                    <t t-esc="u.name"/><t t-if="not loop.last">, </t>
                  </t>
                </t>
              </td>
              <td><t t-esc="t.date_deadline and format_date(t.date_deadline) or ''"/></td>
            </tr>
          </tbody>
        </table>

        <!-- Pager -->
        <t t-call="portal.pager"/>
      </t>
    </t>
  </template>
</odoo>
