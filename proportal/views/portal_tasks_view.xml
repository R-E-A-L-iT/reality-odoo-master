<odoo>
  <template id="portal_my_project_collab_fix" inherit_id="project.portal_my_project">
    <xpath expr="//t[@t-if='not grouped_tasks']" position="attributes">
      <attribute name="t-if">not task_count</attribute>
    </xpath>

    <xpath expr="//t[@t-call='project.portal_tasks_list']" position="before">
      <t t-if="tasks and not grouped_tasks">
        <t t-set="grouped_tasks" t-value="[{'stage': False, 'tasks': tasks}]"/>
      </t>
    </xpath>
  </template>
</odoo>
