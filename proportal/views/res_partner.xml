<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_partner_form_real_proportal" model="ir.ui.view">
        <field name="name">Partner.Backend.Form.real.proportal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="after">
                <field name="company_nickname" invisible="not is_company" />
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="portal_companies_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="products" string="Products">
                    <sheet>
                        <!-- <div t-if="parent_id"> -->
                            <!-- <field name="parentProducts" string="Company Products"/> -->
                        <!-- </div> -->
                        <!-- <div t-if="company_type == 'company'"> -->
                            <field name="products" string="Products"/>
                        <!-- </div> -->
                    </sheet>
                </page>
            </xpath>
        </field>
    </record>
</odoo>