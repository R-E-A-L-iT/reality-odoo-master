<odoo>
    <template id="portal_my_home_courses_card" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="language" t-value="request.lang.code" />
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/knowledge/static/src/img/Books.svg'"/>
                <t t-set="text" t-if="language == 'fr_CA'">Voir tous vos cours</t>
                <t t-set="text" t-elif="language == 'es_ES'">Ver todos sus cursos</t>
                <t t-set="text" t-else="">View all your courses</t>
                <t t-set="title" t-if="language == 'fr_CA'">Cours</t>
                <t t-set="title" t-elif="language == 'es_ES'">Cursos</t>
                <t t-set="title" t-else="">Courses</t>
                <t t-set="url" t-value="'/slides/'"/>
                <t t-set="placeholder_count" t-value="'course_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>
</odoo>