<odoo>
    <template id="portal_my_products" name="My Products">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Products</t>
            </t>

            <t t-if="not products">
                <p>No products found for your associated companies.</p>
                <br />
            </t>

            <t t-if="products" t-call="portal.portal_table">

                <!-- CCP badge colors -->
                <style>
                    .badge-ccp-basic  { background-color: #6c757d; } /* grey */
                    .badge-ccp-blue   { background-color: #0d6efd; } /* blue */
                    .badge-ccp-bronze { background-color: #cd7f32; } /* bronze/brown */
                    .badge-ccp-silver { background-color: #c0c0c0; color: #111; } /* silver */
                    .badge-ccp-gold   { background-color: #d4af37; color: #111; } /* gold */
                    .badge-ccp { font-weight: 600; }
                </style>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Serial Number</th>
                        <th>Expiration</th>
                        <th>Status</th>
                        <th>CCP Type</th>
                    </tr>
                </thead>

                <t t-foreach="products" t-as="product">
                    <tr>
                        <td>
                            <img class="portal_product_image"
                                 t-att-src="'data:image/png;base64,' + product.product_id.image_128.decode('utf-8') if product.product_id.image_128 else ''"/>
                            <t t-esc="product.product_id.name"/>
                        </td>
                        <td><t t-esc="product.name"/></td>
                        <td><t t-esc="product.expire"/></td>

                        <td t-if="product.expire">
                            <style>
                                .badge.bg-grace { background-color: #6f42c1; }
                            </style>
                            <span t-if="product.ccp_status == 'expired'"  class="badge bg-danger">Expired</span>
                            <span t-elif="product.ccp_status == 'grace'" class="badge bg-grace text-dark">Grace period</span>
                            <span t-elif="product.ccp_status == 'expiring'" class="badge bg-warning text-dark">Expiring soon</span>
                            <span t-elif="product.ccp_status == 'active'"   class="badge bg-success">Active</span>
                        </td>
                        <td t-else=""></td>

                        <!-- CCP Type column (blank if none) -->
                        <td>
                            <t t-if="product.ccp_type == 'ccp_basic'">
                                <span class="badge badge-ccp badge-ccp-basic">CCP BASIC</span>
                            </t>
                            <t t-elif="product.ccp_type == 'ccp_blue'">
                                <span class="badge badge-ccp badge-ccp-blue">CCP BLUE</span>
                            </t>
                            <t t-elif="product.ccp_type == 'ccp_bronze'">
                                <span class="badge badge-ccp badge-ccp-bronze">CCP BRONZE</span>
                            </t>
                            <t t-elif="product.ccp_type == 'ccp_silver'">
                                <span class="badge badge-ccp badge-ccp-silver">CCP SILVER</span>
                            </t>
                            <t t-elif="product.ccp_type == 'ccp_gold'">
                                <span class="badge badge-ccp badge-ccp-gold">CCP GOLD</span>
                            </t>
                            <!-- else: leave blank -->
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_home_products_card" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Products.png'"/>
                <t t-set="text">View all your company products</t>
                <t t-set="title">Products</t>
                <t t-set="url" t-value="'/my/products'"/>
                <t t-set="placeholder_count" t-value="'product_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>
</odoo>