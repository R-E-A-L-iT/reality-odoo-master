<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_verify_quote_code" name="Verify Quote Code">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h2>Quote Verification</h2>
                <p>We've sent a 4-digit code to your email. Please enter it below to access the quote.</p>

                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>

                <form method="get" action="">
                    <div class="form-group">
                        <label for="code">Verification Code</label>
                        <input type="text" name="code" class="form-control" required="required" maxlength="4"/>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Verify</button>
                </form>
            </div>
        </t>
    </template>
</odoo>