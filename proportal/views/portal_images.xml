<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_my_home_connection_security_icon_inherit"
              inherit_id="portal.portal_my_home"
              name="Portal My Home - Replace Connection &amp; Security Icon">

        <xpath expr="//div[@id='portal_common_category']//t[@t-set='icon'][@t-value=&quot;'/portal/static/src/img/portal-connection.svg'&quot;]"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Connection-and-Security.png'"/>
            <style>
                .o_portal_icon > img {
                    max-width: 68px;
                }
            </style>
        </xpath>
    </template>

    <template id="portal_my_home_payment_icon_inherit"
              inherit_id="payment.portal_my_home_payment"
              name="Portal My Home - Replace Payment Methods Icon">

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][@t-value=&quot;'/my/payment_method'&quot;]]/t[@t-set='icon']"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Payment-Methods.png'"/>
        </xpath>
    </template>

    <template id="portal_my_home_sale_icon_inherit"
              inherit_id="sale.portal_my_home_sale"
              name="Portal My Home - Replace Sales Orders Icon">

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][@t-value=&quot;'/my/orders'&quot;]]/t[@t-set='icon']"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Sales-Orders.png'"/>
        </xpath>
    </template>

    <template id="portal_my_home_invoice_icon_inherit"
              inherit_id="account.portal_my_home_invoice"
              name="Portal My Home - Replace Invoices Icon">

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][@t-value=&quot;'/my/invoices?filterby=invoices'&quot;]]/t[@t-set='icon']"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Your-Invoices.png'"/>
        </xpath>
         <xpath expr="//div[@id='portal_vendor_category']" position="replace"/>
    </template>

    <template id="portal_my_home_project_icon_inherit"
              inherit_id="project.portal_my_home"
              name="Portal My Home - Replace Projects &amp; Tasks Icon">

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][@t-value=&quot;'/my/projects'&quot;]]/t[@t-set='icon']"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Projects.png'"/>
        </xpath>
        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][@t-value=&quot;'/my/tasks'&quot;]]/t[@t-set='icon']"
               position="replace">
            <t t-set="icon" t-value="'https://cdn.r-e-a-l.it/images/icons/Odoo/Tasks.png'"/>
        </xpath>
    </template>

</odoo>
