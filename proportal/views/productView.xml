<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- This record carried NO <field name="arch"> for years. An arch-less view
         record does not replace the arch already stored in the database, so the
         2022-era arch (containing the xpath //div[2]/div, which no longer resolves
         against the Odoo 19 product form) survived in ir.ui.view and was
         re-validated on every module update — aborting the upgrade with a
         ParseError that pointed at this file even though the file had nothing in it.

         The empty <data/> below is a valid, no-op inheritance spec. It overwrites
         the stale stored arch and cannot fail to locate anything. -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <data/>
        </field>
    </record>
</odoo>
