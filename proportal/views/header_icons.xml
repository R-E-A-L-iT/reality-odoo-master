<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_language_selector_globe" inherit_id="portal.language_selector">
        <!-- Keep t-attf-class="dropdown-toggle" and the label spans. website.language_selector
             and website.language_selector_inline anchor on those, and replacing the
             whole button makes the inline selector fail on upgrade. -->
        <xpath expr="//button[contains(@t-attf-class, 'dropdown-toggle')]" position="replace">
            <button type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true"
                    t-attf-class="btn border-0 dropdown-toggle rounded-circle text-reset o_navlink_background #{_btn_class or ''}">
                <span t-if="not no_text"
                      t-attf-class="#{_txt_class}"
                      t-esc="active_lang.name.split('/').pop()"/>
                <span t-elif="codes" class="align-middle" t-esc="active_lang.url_code.split('_').pop(0).upper()"/>
                <i class="fa fa-1x fa-fw fa-globe fa-stack"/>
            </button>
        </xpath>
    </template>
</odoo>