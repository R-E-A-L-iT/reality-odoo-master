<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="promessaging_ai_chat_rule_own" model="ir.rule">
            <field name="name">AI chats: mine, or addressed to my sub-users</field>
            <field name="model_id" ref="model_promessaging_ai_chat"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('subuser_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="promessaging_ai_chat_message_rule_own" model="ir.rule">
            <field name="name">AI chat messages: mine, or addressed to my sub-users</field>
            <field name="model_id" ref="model_promessaging_ai_chat_message"/>
            <field name="domain_force">['|', ('chat_id.user_id', '=', user.id), ('chat_id.subuser_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
