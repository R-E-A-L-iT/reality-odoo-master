<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="promessaging_subuser_view_form" model="ir.ui.view">
        <field name="name">promessaging.subuser.form</field>
        <field name="model">promessaging.subuser</field>
        <field name="arch" type="xml">
            <form string="AI Sub-user">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="log_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Grok Sales"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <label for="handle"/>
                            <div>
                                <span>~</span><field name="handle" class="oe_inline" placeholder="groksales"/>
                            </div>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="post_reply"/>
                        </group>
                    </group>
                    <group string="Webhook" groups="base.group_system">
                        <field name="webhook_url" placeholder="https://grokbot.example.com/hooks/odoo" widget="url"/>
                        <field name="webhook_token" password="True"/>
                        <field name="webhook_secret" password="True"/>
                        <field name="webhook_timeout"/>
                    </group>
                    <group string="Role">
                        <field name="description" nolabel="1" colspan="2"
                               placeholder="What this sub-user does. Sent to the bot with every call."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promessaging_subuser_view_tree" model="ir.ui.view">
        <field name="name">promessaging.subuser.tree</field>
        <field name="model">promessaging.subuser</field>
        <field name="arch" type="xml">
            <tree string="AI Sub-users">
                <field name="name"/>
                <field name="handle"/>
                <field name="user_id"/>
                <field name="post_reply" optional="show"/>
                <field name="log_count" string="Calls" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="promessaging_subuser_action" model="ir.actions.act_window">
        <field name="name">AI Sub-users</field>
        <field name="res_model">promessaging.subuser</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a sub-user</p>
            <p>Sub-users belong to an AI user and are pinged with ~handle in any message.</p>
        </field>
    </record>

    <record id="promessaging_webhook_log_view_tree" model="ir.ui.view">
        <field name="name">promessaging.webhook.log.tree</field>
        <field name="model">promessaging.webhook.log</field>
        <field name="arch" type="xml">
            <tree string="Webhook Calls" decoration-danger="state == 'error'"
                  decoration-muted="state == 'pending'" create="false">
                <field name="create_date" string="Sent"/>
                <field name="subuser_id"/>
                <field name="webhook_type"/>
                <field name="res_model" optional="show"/>
                <field name="res_id" optional="hide"/>
                <field name="status_code"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="promessaging_webhook_log_view_form" model="ir.ui.view">
        <field name="name">promessaging.webhook.log.form</field>
        <field name="model">promessaging.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Call" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="oe_highlight"/>
                    <button name="action_open_document" type="object" string="Open Document"
                            invisible="not res_model"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subuser_id"/>
                            <field name="webhook_type"/>
                            <field name="event_id"/>
                        </group>
                        <group>
                            <field name="status_code"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error" readonly="1"/>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_body" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promessaging_webhook_log_action" model="ir.actions.act_window">
        <field name="name">Sub-user Webhook Calls</field>
        <field name="res_model">promessaging.webhook.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_promessaging_subuser" name="AI Sub-users"
              parent="base.menu_email" action="promessaging_subuser_action" sequence="50"
              groups="base.group_system"/>
    <menuitem id="menu_promessaging_webhook_log" name="Sub-user Webhook Calls"
              parent="base.menu_email" action="promessaging_webhook_log_action" sequence="51"
              groups="base.group_system"/>

</odoo>
