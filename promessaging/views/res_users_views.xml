<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_promessaging" model="ir.ui.view">
        <field name="name">res.users.form.promessaging</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="before">
                <group string="Messaging" name="promessaging" invisible="share">
                    <field name="can_send_message"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_tree_promessaging" model="ir.ui.view">
        <field name="name">res.users.tree.promessaging</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login_date']" position="after">
                <field name="can_send_message" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
