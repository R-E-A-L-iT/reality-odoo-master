<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="summaries_summary_rule_own" model="ir.rule">
            <field name="name">Summaries: own summaries</field>
            <field name="model_id" ref="model_summaries_summary"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="summaries_summary_rule_manager" model="ir.rule">
            <field name="name">Summaries: all summaries (manager)</field>
            <field name="model_id" ref="model_summaries_summary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('summaries.group_summaries_manager'))]"/>
        </record>

        <record id="summaries_objective_rule_own" model="ir.rule">
            <field name="name">Summaries: own objectives</field>
            <field name="model_id" ref="model_summaries_objective"/>
            <field name="domain_force">[('summary_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="summaries_objective_rule_manager" model="ir.rule">
            <field name="name">Summaries: all objectives (manager)</field>
            <field name="model_id" ref="model_summaries_objective"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('summaries.group_summaries_manager'))]"/>
        </record>
    </data>
</odoo>
