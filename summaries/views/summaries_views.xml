<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="summaries_summary_view_form" model="ir.ui.view">
        <field name="name">summaries.summary.form</field>
        <field name="model">summaries.summary</field>
        <field name="arch" type="xml">
            <form string="Daily Summary">
                <header>
                    <button name="action_mark_all_done" type="object" string="Mark all done"
                            class="oe_highlight" invisible="objective_count == objective_done_count"/>
                    <field name="progress" widget="progressbar" class="oe_inline"/>
                </header>
                <sheet>
                    <field name="is_summaries_manager" invisible="1"/>
                    <field name="objective_count" invisible="1"/>
                    <field name="objective_done_count" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="not is_summaries_manager"
                                   options="{'no_create': True}"/>
                            <field name="date" readonly="not is_summaries_manager"/>
                        </group>
                        <group>
                            <label for="objective_done_count" string="Objectives done"/>
                            <div>
                                <field name="objective_done_count" class="oe_inline" readonly="1"/>
                                <span> / </span>
                                <field name="objective_count" class="oe_inline" readonly="1"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="To-Do" name="todo">
                            <field name="objective_ids">
                                <tree editable="bottom" decoration-muted="done">
                                    <field name="sequence" widget="handle"/>
                                    <field name="done" widget="boolean_toggle"/>
                                    <field name="name"/>
                                    <field name="record_ref" string="Related Document"/>
                                    <field name="note"/>
                                    <field name="done_date" optional="hide" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="body" placeholder="Notes, checklists, images, tables..."/>
                        </page>
                        <page string="Performance" name="performance">
                            <widget name="summaries_stats"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="summaries_summary_view_tree" model="ir.ui.view">
        <field name="name">summaries.summary.tree</field>
        <field name="model">summaries.summary</field>
        <field name="arch" type="xml">
            <tree string="Summaries" decoration-success="progress &gt;= 100">
                <field name="date"/>
                <field name="user_id"/>
                <field name="objective_done_count" string="Done"/>
                <field name="objective_count" string="Objectives"/>
                <field name="progress" widget="progressbar"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="summaries_summary_view_search" model="ir.ui.view">
        <field name="name">summaries.summary.search</field>
        <field name="model">summaries.summary</field>
        <field name="arch" type="xml">
            <search string="Summaries">
                <field name="user_id"/>
                <field name="date"/>
                <filter name="my_summaries" string="My Summaries"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=-1, days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="unfinished" string="Unfinished" domain="[('progress', '&lt;', 100)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="summaries_summary_action_my" model="ir.actions.act_window">
        <field name="name">My Summaries</field>
        <field name="res_model">summaries.summary</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_summaries': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No summary yet</p>
            <p>A summary is created for you on every business day.</p>
        </field>
    </record>

    <record id="summaries_summary_action_all" model="ir.actions.act_window">
        <field name="name">All Summaries</field>
        <field name="res_model">summaries.summary</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_user': 1}</field>
    </record>

    <record id="summaries_summary_action_today" model="ir.actions.server">
        <field name="name">Today's Summary</field>
        <field name="model_id" ref="model_summaries_summary"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_today()</field>
    </record>

</odoo>
