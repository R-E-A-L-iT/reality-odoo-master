<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add LiveChat Lead field to Channel Form -->
        <record id="discuss_channel_form_livechat_lead" model="ir.ui.view">
            <field name="name">discuss.channel.form.livechat.lead</field>
            <field name="model">discuss.channel</field>
            <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='group_ids']" position="after">
                    <field name="livechat_lead_id" 

                           options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Add LiveChat Sessions to CRM Lead Form -->
        <record id="crm_lead_form_livechat_sessions" model="ir.ui.view">
            <field name="name">crm.lead.form.livechat.sessions</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_livechat_sessions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-comments-o"
                            >
                        <field name="livechat_channel_count" widget="statinfo" 
                               string="LiveChat Sessions"/>
                    </button>
                </xpath>
            </field>
        </record>

