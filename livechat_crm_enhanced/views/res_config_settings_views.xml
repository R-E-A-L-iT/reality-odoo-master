<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_livechat_crm" model="ir.ui.view">
        <field name="name">res.config.settings.view.livechat.crm.enhanced</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="LiveChat Lead Assignment">
                    <setting string="Default Lead Owner (Chatbot)"
                             help="Salesperson automatically assigned to CRM leads created by the website chatbot. Leave empty to keep the chatbot operator as the owner.">
                        <field name="livechat_default_lead_user_id"/>
                    </setting>
                    <setting string="Default Sales Team (Chatbot)"
                             help="Sales team automatically assigned to CRM leads created by the website chatbot.">
                        <field name="livechat_default_lead_team_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
