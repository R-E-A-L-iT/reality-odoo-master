<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ba_ai_email_reply.Chatter"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="after">
            <button
                t-if="state.thread and state.thread.model === 'crm.lead' and props.hasMessageList"
                class="o-mail-Chatter-generateAiReply btn btn-secondary text-nowrap me-1"
                t-att-class="{'my-2': !props.compactHeight}"
                t-att-disabled="!state.thread.hasWriteAccess or !props.threadId or aiGenerating"
                t-on-click="() => this.generateAiReply()">
                <t t-if="!aiGenerating">Generate AI Reply</t>
                <t t-else="">Generating...</t>
            </button>
        </xpath>
    </t>
</templates>
